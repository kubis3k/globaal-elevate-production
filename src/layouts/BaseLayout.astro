---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  lang?: string
}

const {
  title,
  description = 'Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je holding, který spojuje hudbu, kreativu a technologii pod jednou vizí.',
  lang = 'cs',
} = Astro.props
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&family=Playfair+Display:ital,wght@0,700;1,400;1,700&display=swap" rel="stylesheet" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title} — Globaal Elevate</title>
  </head>

  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Theme persistence
      const stored = localStorage.getItem('theme')
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored)
      }

      // IntersectionObserver for scroll animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          })
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px',
        }
      )

      document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
        observer.observe(el)
      })

      // Trigger elements already in viewport on load
      requestAnimationFrame(() => {
        document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
          const rect = el.getBoundingClientRect()
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-visible')
          }
        })
      })
    </script>
  </body>
</html>

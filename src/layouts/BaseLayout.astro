---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import NewsletterPopup from '../components/NewsletterPopup.astro'
import CookieBanner from '../components/CookieBanner.astro'
import '../styles/global.css'

// Self-hosted font — GDPR compliant (no CDN)
// Archivo Variable: wdth axis for condensed headings (font-stretch: 75%)
import '@fontsource-variable/archivo/wdth.css'

interface Props {
  title: string
  description?: string
  lang?: string
  image?: string
  noindex?: boolean
}

const {
  title,
  description = 'Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je kreativní skupina, která spojuje hudbu, kreativu a technologii pod jednou vizí.',
  lang = 'cs',
  image = '/og-image.jpg',
  noindex = false,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, 'https://globaalelevate.com').href
const ogImageUrl = new URL(image, 'https://globaalelevate.com').href
const fullTitle = `${title} — Globaal Elevate Production`

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://globaalelevate.com/#organization',
    name: 'Globaal Elevate Production',
    legalName: 'Globaal Elevate Production s.r.o.',
    alternateName: 'GEP',
    url: 'https://globaalelevate.com',
    logo: 'https://globaalelevate.com/logo.png',
    taxID: '24972070',
    vatID: 'CZ24972070',
    foundingDate: '2026-04-20',
    description: lang === 'en'
      ? 'Creative group combining music, marketing and technology under one vision.'
      : 'Kreativní skupina spojující hudbu, marketing a technologii pod jednou vizí.',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Dlouhá 715/38',
      addressLocality: 'Praha',
      addressRegion: 'Staré Město',
      postalCode: '110 00',
      addressCountry: 'CZ',
    },
    sameAs: [
      'https://3lwave.cz',
      'https://visiontechnology.cz',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'info@globaalelevate.com',
      contactType: 'customer service',
      availableLanguage: ['Czech', 'English'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://globaalelevate.com/#website',
    url: 'https://globaalelevate.com',
    name: 'Globaal Elevate Production',
    inLanguage: ['cs-CZ', 'en-US'],
    publisher: { '@id': 'https://globaalelevate.com/#organization' },
  },
]
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'cs_CZ'} />
    <meta property="og:site_name" content="Globaal Elevate Production" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Alternate language -->
    {lang === 'cs' && <link rel="alternate" hreflang="en" href={`https://globaalelevate.com/en${Astro.url.pathname}`} />}
    {lang === 'en' && <link rel="alternate" hreflang="cs" href={`https://globaalelevate.com${Astro.url.pathname.replace(/^\/en/, '')}`} />}
    <link rel="alternate" hreflang="x-default" href="https://globaalelevate.com/" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{fullTitle}</title>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <NewsletterPopup lang={lang} />
    <CookieBanner lang={lang} />

    <script>
      // IntersectionObserver for scroll animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      )

      document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
        observer.observe(el)
      })

      requestAnimationFrame(() => {
        document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
          const rect = el.getBoundingClientRect()
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-visible')
          }
        })
      })
    </script>
  </body>
</html>

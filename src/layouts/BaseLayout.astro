---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import NewsletterPopup from '../components/NewsletterPopup.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  lang?: string
  image?: string
}

const {
  title,
  description = 'Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je kreativní skupina, která spojuje hudbu, kreativu a technologii pod jednou vizí.',
  lang = 'cs',
  image = '/og-image.jpg',
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, 'https://globaalelevate.com').href
const ogImageUrl = new URL(image, 'https://globaalelevate.com').href
const fullTitle = `${title} — Globaal Elevate Production`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Globaal Elevate Production s.r.o.',
  alternateName: 'GEP',
  url: 'https://globaalelevate.com',
  logo: 'https://globaalelevate.com/logo.png',
  description: lang === 'en'
    ? 'Creative group combining music, marketing and technology under one vision.'
    : 'Kreativní skupina spojující hudbu, marketing a technologii pod jednou vizí.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Dlouhá 715/38',
    addressLocality: 'Praha',
    postalCode: '110 00',
    addressCountry: 'CZ',
  },
  sameAs: [
    'https://3lwave.cz',
    'https://visiontechnology.cz',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@globaalelevate.com',
    contactType: 'customer service',
    availableLanguage: ['Czech', 'English'],
  },
}
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'cs_CZ'} />
    <meta property="og:site_name" content="Globaal Elevate Production" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Alternate language -->
    {lang === 'cs' && <link rel="alternate" hreflang="en" href={`https://globaalelevate.com/en${Astro.url.pathname}`} />}
    {lang === 'en' && <link rel="alternate" hreflang="cs" href={`https://globaalelevate.com${Astro.url.pathname.replace(/^\/en/, '')}`} />}
    <link rel="alternate" hreflang="x-default" href="https://globaalelevate.com/" />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{fullTitle}</title>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <NewsletterPopup lang={lang} />

    <script>
      // Theme persistence
      const stored = localStorage.getItem('theme')
      document.documentElement.setAttribute('data-theme', stored || 'light')

      // IntersectionObserver for scroll animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          })
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px',
        }
      )

      document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
        observer.observe(el)
      })

      // Trigger elements already in viewport on load
      requestAnimationFrame(() => {
        document.querySelectorAll('.anim-fade, .anim-stagger').forEach((el) => {
          const rect = el.getBoundingClientRect()
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-visible')
          }
        })
      })
    </script>
  </body>
</html>

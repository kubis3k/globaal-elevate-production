---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Odkaz vypršel"
  description="Odkaz pro potvrzení přihlášení k newsletteru není platný nebo vypršel."
  lang="cs"
>
  <section class="exp-section">
    <div class="container exp-inner">
      <div class="exp-icon" aria-hidden="true">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v4"/>
          <path d="M12 16h.01"/>
        </svg>
      </div>
      <h1 class="exp-heading">Odkaz vypršel nebo není platný.</h1>
      <p class="exp-lead">
        Potvrzovací odkaz je platný 48 hodin. Zkuste se přihlásit znovu — pošleme vám nový e-mail.
      </p>

      <!-- Inline re-subscribe form -->
      <div class="exp-form-wrap">
        <form class="exp-form" id="exp-form" novalidate>
          <!-- Honeypot -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;"
          />
          <label class="exp-label" for="exp-email">Váš e-mail</label>
          <div class="exp-row">
            <input
              type="email"
              id="exp-email"
              name="email"
              placeholder="vas@email.cz"
              required
              autocomplete="email"
              class="exp-input"
            />
            <button type="submit" class="exp-btn" id="exp-btn">
              <span class="exp-btn-text">Přihlásit se znovu</span>
              <span class="exp-btn-spinner" hidden aria-hidden="true">
                <svg class="spinner-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                </svg>
              </span>
            </button>
          </div>
          <p class="exp-err" id="exp-err" aria-live="polite"></p>
        </form>

        <div class="exp-success" id="exp-success" hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Skoro hotovo! Zkontrolujte svůj e-mail a klikněte na odkaz v něm.</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('exp-form') as HTMLFormElement
  const input = document.getElementById('exp-email') as HTMLInputElement
  const btn = document.getElementById('exp-btn') as HTMLButtonElement
  const btnText = btn.querySelector('.exp-btn-text') as HTMLElement
  const btnSpinner = btn.querySelector('.exp-btn-spinner') as HTMLElement
  const errEl = document.getElementById('exp-err') as HTMLElement
  const successEl = document.getElementById('exp-success') as HTMLElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = input.value.trim()
    if (!email) return

    btn.disabled = true
    btnText.hidden = true
    btnSpinner.hidden = false
    errEl.textContent = ''

    try {
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]')
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, website: honeypot?.value ?? '', source: 'resubscribe' }),
      })

      if (res.ok || res.status === 200) {
        form.hidden = true
        successEl.hidden = false
      } else {
        const data = await res.json().catch(() => ({}))
        errEl.textContent = data.error === 'Invalid email'
          ? 'Zadejte platný e-mail.'
          : 'Něco se pokazilo, zkuste to prosím znovu.'
        btn.disabled = false
        btnText.hidden = false
        btnSpinner.hidden = true
      }
    } catch {
      errEl.textContent = 'Něco se pokazilo, zkuste to prosím znovu.'
      btn.disabled = false
      btnText.hidden = false
      btnSpinner.hidden = true
    }
  })
</script>

<style>
  .exp-section {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    background: var(--bg);
    padding: 6rem 0;
  }

  .exp-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 520px;
  }

  .exp-icon {
    width: 80px;
    height: 80px;
    border-radius: 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
  }

  .exp-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }

  .exp-lead {
    font-size: 1.0625rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin: 0;
  }

  .exp-form-wrap {
    width: 100%;
    margin-top: 0.5rem;
  }

  .exp-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .exp-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #555;
  }

  .exp-row {
    display: flex;
    gap: 0.625rem;
  }

  .exp-input {
    flex: 1;
    height: 48px;
    background: #FAFAFA;
    border: 1px solid #E3E3E3;
    border-radius: 10px;
    padding: 0 1rem;
    font-size: 0.9375rem;
    color: var(--fg);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .exp-input::placeholder { color: #aaa; }

  .exp-input:focus {
    border-color: #B5976A;
    box-shadow: 0 0 0 3px rgba(181, 151, 106, 0.2);
  }

  .exp-input.invalid { border-color: #D64545; }

  .exp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 48px;
    padding: 0 1.5rem;
    background: #B5976A;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .exp-btn:hover:not(:disabled) { background: #A3845A; }
  .exp-btn:disabled { opacity: 0.65; cursor: not-allowed; }

  .spinner-svg { animation: spin 0.8s linear infinite; }

  @keyframes spin { to { transform: rotate(360deg); } }

  .exp-err {
    font-size: 0.8125rem;
    color: #D64545;
    margin: 0;
    min-height: 1em;
  }

  .exp-success {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    background: #F0F9EE;
    border: 1px solid #86EFAC;
    border-radius: 10px;
    font-size: 0.9375rem;
    color: #166534;
    line-height: 1.55;
  }

  .exp-success svg { flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 480px) {
    .exp-row { flex-direction: column; }
    .exp-btn { width: 100%; }
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro'
import SectionLabel from '../components/SectionLabel.astro'
---

<PageLayout
  title="O nás"
  description="Globaal Elevate Production — holding, který vyrostl ze severočeské scény. Hudba, kreativa a technologie pod jednou vizí."
  badge="• Kdo jsme"
  heading="Vyrostli jsme ze scény."
  lead="Než jsme byli holding, byli jsme lidi kolem hudby a eventů v severních Čechách."
  lang="cs"
>
  <!-- Mise -->
  <section class="section">
    <div class="container">
      <div class="asym-grid anim-fade">
        <div>
          <SectionLabel text="Naše mise" />
          <p class="meta-text">Od roku 2026</p>
        </div>
        <div class="mission-body">
          <h2 class="section-heading">Z reálné scény do holdingu</h2>
          <p class="body-text">
            Globaal Elevate Production vznikl z reálné scény, ne z tabulky. Než jsme byli holding, byli jsme lidi kolem hudby a eventů v severních Čechách — a z toho zázemí jsme rozrostli do marketingové kreativy, vlastního IT vývoje a SaaS produktů.
          </p>
          <p class="body-text">
            Každá značka pod námi řeší problém, který jsme sami zažili. Sídlíme v Praze, ale kořeny máme na severu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hodnoty -->
  <section class="section values-section">
    <div class="container">
      <div class="anim-fade">
        <SectionLabel text="Naše hodnoty" />
        <h2 class="section-heading">Co nás pohání</h2>
      </div>

      <div class="values-grid anim-stagger">
        <div class="card value-card">
          <div class="value-number">01</div>
          <h3>Inovace</h3>
          <p>Hledáme řešení, která ještě neexistují. Každý projekt je experimentem — metodickým, ale odvážným.</p>
        </div>
        <div class="card value-card">
          <div class="value-number">02</div>
          <h3>Autenticita</h3>
          <p>Nevytváříme značky jen proto, aby vypadaly dobře. Tvoříme je tak, aby mluvily pravdu o svém zakladateli.</p>
        </div>
        <div class="card value-card">
          <div class="value-number">03</div>
          <h3>Globální přesah</h3>
          <p>Lokální kořeny, globální ambice. Budujeme projekty, které mají potenciál oslovit svět.</p>
        </div>
        <div class="card value-card">
          <div class="value-number">04</div>
          <h3>Výsledky</h3>
          <p>Kreativita bez výsledků je jen záměr. Soustředíme se na měřitelný dopad každého projektu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Značky -->
  <section class="section brands-section">
    <div class="container">
      <div class="anim-fade">
        <SectionLabel text="Portfolio" />
        <h2 class="section-heading">Naše projekty</h2>
      </div>

      <div class="brands-list anim-stagger">
        <a href="https://3lwave.cz" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Eventy</span>
            <strong>3lwave</strong>
          </div>
          <p>Eventová značka nové generace — hudba, zážitky a propojení lidí.</p>
          <span class="arrow">→</span>
        </a>
        <a href="https://3lwave.cz/label" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Hudba</span>
            <strong>Globaal Records</strong>
          </div>
          <p>Nezávislé vydavatelství zaměřené na autentické umělce a originální zvuky.</p>
          <span class="arrow">→</span>
        </a>
        <a href="/portfolio" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Kreativa</span>
            <strong>Globaal Production</strong>
          </div>
          <p>Kreativní a marketingová agentura — branding, web development a telesales pro malé a střední firmy.</p>
          <span class="arrow">→</span>
        </a>
        <a href="https://visiontechnology.cz" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Technologie</span>
            <strong>Vision Technology</strong>
          </div>
          <p>Vývoj AI systémů, webů a digitálních produktů na zakázku.</p>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .section-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .meta-text {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-top: 1rem;
  }

  .body-text {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .mission-body {
    max-width: 640px;
  }

  .values-section {
    background: var(--bg-surface);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .value-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .value-number {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .value-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .value-card p {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.65;
  }

  .brands-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .brand-row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brand-tag {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .brand-info strong {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .brand-row p {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .arrow {
    font-size: 1.25rem;
    color: var(--fg-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .brand-row:hover .arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .values-grid {
      grid-template-columns: 1fr;
    }

    .brand-row {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
    }

    .brand-row p {
      grid-column: 1;
    }
  }
</style>

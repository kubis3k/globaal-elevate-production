---
if (import.meta.env.PROD) {
  return Astro.redirect('/404', 404)
}

import BaseLayout from '../layouts/BaseLayout.astro'
import SectionLabel from '../components/SectionLabel.astro'
import Stat from '../components/Stat.astro'
---

<BaseLayout title="Design System — Revize 1" lang="cs" noindex>
<div class="ds">

  <!-- Title -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <h1 style="color:var(--white)">Design System</h1>
      <p style="color:var(--muted-dark);margin-top:.75rem">Globaal Elevate Production — Revize 1: Editorial</p>
    </div>
  </section>

  <!-- ── BARVY ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Barvy</p>
      <div class="ds-swatches">
        <div class="ds-sw" style="background:#0A0A0A;border:1px solid #333"><span style="color:#fff">ink<br/>#0A0A0A</span></div>
        <div class="ds-sw" style="background:#151515"><span style="color:#fff">ink-2<br/>#151515</span></div>
        <div class="ds-sw" style="background:#FFFFFF;border:1px solid #ddd"><span style="color:#0A0A0A">white<br/>#FFFFFF</span></div>
        <div class="ds-sw" style="background:#F2F2F2;border:1px solid #ddd"><span style="color:#0A0A0A">grey-100<br/>#F2F2F2</span></div>
        <div class="ds-sw" style="background:#6C2BD9"><span>violet-600<br/>#6C2BD9</span></div>
        <div class="ds-sw" style="background:#7C3FE8"><span>violet-500<br/>#7C3FE8</span></div>
        <div class="ds-sw" style="background:#5420B0"><span>violet-700<br/>#5420B0</span></div>
        <div class="ds-sw" style="background:#A98BFF"><span>violet-400<br/>#A98BFF</span></div>
        <div class="ds-sw" style="background:#D64545"><span>danger<br/>#D64545</span></div>
        <div class="ds-sw" style="background:#3FA672"><span>success<br/>#3FA672</span></div>
      </div>

      <!-- Contrast table -->
      <p class="ds-cat" style="margin-top:2.5rem">Kontrast WCAG (přepočítáno)</p>
      <table class="ds-table">
        <thead>
          <tr><th>Text</th><th>Pozadí</th><th>Poměr</th><th>AA (4.5:1)</th><th>AAA (7:1)</th></tr>
        </thead>
        <tbody>
          <tr><td>#FFFFFF bílá</td><td>violet-600 #6C2BD9</td><td>≈ 7.0 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td>violet-600 #6C2BD9</td><td>#FFFFFF bílá</td><td>≈ 7.0 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td>violet-400 #A98BFF</td><td>ink #0A0A0A</td><td>≈ 7.1 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td style="color:#D64545">violet-600 #6C2BD9 na ink</td><td>ink #0A0A0A</td><td>≈ 2.8 : 1</td><td>❌ NEPOUŽÍVAT</td><td>❌</td></tr>
          <tr><td>#FFFFFF bílá</td><td>ink #0A0A0A</td><td>≈ 19.6 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td>rgba(255,255,255,.64) muted-dark</td><td>ink #0A0A0A</td><td>≈ 10.5 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td>#0A0A0A ink</td><td>#FFFFFF bílá</td><td>≈ 19.6 : 1</td><td>✅</td><td>✅</td></tr>
          <tr><td>#5C5C5C muted-light</td><td>#FFFFFF bílá</td><td>≈ 5.9 : 1</td><td>✅</td><td>❌</td></tr>
          <tr><td>#5C5C5C muted-light</td><td>grey-100 #F2F2F2</td><td>≈ 5.5 : 1</td><td>✅</td><td>❌</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TYPOGRAFIE ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Typografie — Archivo Variable (wdth 75 headings, wdth 100 body)</p>

      <!-- Czech language test -->
      <div style="border:1px solid var(--line-dark);padding:1.5rem;margin-bottom:2rem">
        <p class="ds-cat" style="margin-bottom:1rem">Test češtiny — každý znak musí být v Archivo Variable:</p>
        <h2 style="color:var(--white);margin-bottom:.5rem">PŘÍLIŠ ŽLUŤOUČKÝ KŮŇ ÚPĚL ĎÁBELSKÉ ÓDY.</h2>
        <h3 style="color:var(--muted-dark);margin-bottom:.5rem;font-size:1.5rem">ĚŠČŘŽÝÁÍÉÚŮĎŤŇ</h3>
        <p style="color:var(--muted-dark)">Příliš žluťoučký kůň úpěl ďábelské ódy. ěščřžýáíéúůďťň (400)</p>
        <p style="color:var(--muted-dark);font-weight:600">Příliš žluťoučký kůň úpěl ďábelské ódy. ěščřžýáíéúůďťň (600)</p>
        <p style="color:var(--muted-dark);font-weight:800">Příliš žluťoučký kůň úpěl ďábelské ódy. ěščřžýáíéúůďťň (800)</p>
      </div>

      <h1 style="color:var(--white);margin-bottom:1rem">H1 — clamp(3.25rem,9vw,8.5rem) wght 800 wdth 75</h1>
      <h2 style="color:var(--white);margin-bottom:1rem">H2 — clamp(2.5rem,6vw,5rem) wght 800 wdth 75</h2>
      <h3 style="color:var(--muted-dark);margin-bottom:1rem">H3 — clamp(2.25rem,5vw,4.5rem) wght 800 wdth 75</h3>
      <p style="color:var(--muted-dark);margin-bottom:.5rem">Body — 17px/1.6 Archivo wdth 100 wght 400 — Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem.</p>
      <p style="color:var(--muted-dark);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.12em">Label — 12px wght 600 uppercase letter-spacing .12em</p>
    </div>
  </section>

  <!-- ── SECTION LABEL ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">SectionLabel — tmavé pozadí</p>
      <SectionLabel num="01" text="Portfolio" />
      <SectionLabel num="02" text="Kdo jsme" />
    </div>
  </section>
  <section class="ds-sec surface-white">
    <div class="container">
      <p class="ds-cat" style="color:var(--muted-light)">SectionLabel — světlé pozadí</p>
      <SectionLabel num="01" text="Portfolio" onLight />
    </div>
  </section>

  <!-- ── TLAČÍTKA ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Tlačítka — tmavé pozadí</p>
      <div class="ds-row" style="gap:1rem;margin-bottom:2rem">
        <a href="#" class="btn btn-primary">Primary <span class="btn-arrow">→</span></a>
        <a href="#" class="btn btn-secondary">Secondary</a>
        <a href="#" class="btn btn-ghost">Ghost link <span class="btn-arrow">→</span></a>
      </div>
      <p class="ds-cat">Tlačítka — světlé pozadí</p>
      <div class="ds-row" style="gap:1rem;background:var(--white);padding:2rem">
        <a href="#" class="btn btn-navy">Navy <span class="btn-arrow">→</span></a>
        <a href="#" class="btn btn-primary">Primary (i na světlém)</a>
      </div>
    </div>
  </section>

  <!-- ── BRAND ROW ── -->
  <section class="ds-sec surface-white">
    <div class="container">
      <p class="ds-cat" style="color:var(--muted-light)">BrandRow — hover pro efekt (ink bg, bílý text, violet čtvereček)</p>
      <div role="list">
        <a href="#" class="brand-row" role="listitem">
          <span class="violet-sq" aria-hidden="true"></span>
          <span class="brand-row-num">01</span>
          <span class="brand-row-name">3lwave</span>
          <div class="brand-row-desc">
            <span class="brand-row-cat">Eventy</span>
            <p class="brand-row-text">Eventová značka nové generace — hudba, zážitky a propojení lidí.</p>
          </div>
          <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
        </a>
        <a href="#" class="brand-row" role="listitem">
          <span class="violet-sq" aria-hidden="true"></span>
          <span class="brand-row-num">02</span>
          <span class="brand-row-name">Vision Technology</span>
          <div class="brand-row-desc">
            <span class="brand-row-cat">Technologie</span>
            <p class="brand-row-text">AI systémy, weby a digitální vývoj na zakázku.</p>
          </div>
          <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── STAT ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Stat — statické (žádná animace)</p>
      <div style="display:flex;gap:3rem">
        <Stat value="2026" label="Rok vzniku" />
        <Stat value="4" label="Aktivní značky" />
        <Stat value="Praha · CZ" label="Sídlo" />
      </div>
    </div>
  </section>

  <!-- ── REVEAL ANIMACE ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Reveal animace (scroll, translateY 12px, 300ms)</p>
      <div class="ds-row anim-stagger" style="gap:1rem">
        <div style="background:var(--ink-2);border:1px solid var(--line-dark);padding:1.5rem">
          <p style="color:var(--text-dark)">Karta 1 — 0ms</p>
        </div>
        <div style="background:var(--ink-2);border:1px solid var(--line-dark);padding:1.5rem">
          <p style="color:var(--text-dark)">Karta 2 — 60ms</p>
        </div>
        <div style="background:var(--ink-2);border:1px solid var(--line-dark);padding:1.5rem">
          <p style="color:var(--text-dark)">Karta 3 — 120ms</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── GREP VÝSLEDEK ── -->
  <section class="ds-sec surface-ink">
    <div class="container">
      <p class="ds-cat">Grep — zakázané vzory</p>
      <p style="color:var(--muted-dark);font-size:.875rem;margin-bottom:1rem">
        Vzory: rounded-3xl|rounded-[2-9]xl|blur-|gradient|shadow|italic|font-serif
      </p>
      <pre class="ds-pre" id="grep-output">Načítám…</pre>
    </div>
  </section>

</div>
</BaseLayout>

<script>
  // Run grep check in browser (results from build output shown)
  const el = document.getElementById('grep-output')
  if (el) {
    el.textContent = `Spusť ručně v terminálu:
grep -rn "rounded-3xl\\|rounded-[2-9]xl\\|blur-\\|gradient\\|shadow\\|italic\\|font-serif" src/

Očekávaný výsledek: žádné shody (nebo jen povolené výjimky).
Výjimky: backdrop-filter:blur v popup overlay je záměrný (povoleno pro čitelnost modálu).`
  }
</script>

<style>
  .ds {
    min-height: 100vh;
  }

  .ds-sec {
    padding: 4rem 0;
    border-bottom: 1px solid var(--line-dark);
  }

  .ds-sec.surface-white { border-bottom-color: var(--line-light); }

  .ds-cat {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--violet-400);
    margin-bottom: 1.5rem;
    padding-bottom: .75rem;
    border-bottom: 1px solid var(--line-dark);
    max-width: none;
  }

  .surface-white .ds-cat {
    color: var(--violet-600);
    border-bottom-color: var(--line-light);
  }

  .ds-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .ds-sw {
    width: 120px;
    height: 80px;
    border-radius: 0;
    display: flex;
    align-items: flex-end;
    padding: 8px;
  }

  .ds-sw span {
    font-size: .625rem;
    font-family: monospace;
    color: rgba(255,255,255,.75);
    line-height: 1.4;
  }

  .ds-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .8125rem;
    color: var(--text-dark);
    margin-top: 1rem;
  }

  .ds-table th {
    text-align: left;
    padding: .5rem .75rem;
    border-bottom: 1px solid var(--line-dark);
    color: var(--muted-dark);
    font-size: .6875rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .ds-table td {
    padding: .5rem .75rem;
    border-bottom: 1px solid rgba(255,255,255,.04);
    font-family: monospace;
    font-size: .75rem;
    color: var(--muted-dark);
  }

  .ds-table td:nth-child(3),
  .ds-table td:nth-child(4),
  .ds-table td:nth-child(5) {
    text-align: center;
    font-family: inherit;
    font-size: .875rem;
  }

  .ds-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .ds-pre {
    font-family: monospace;
    font-size: .8125rem;
    color: var(--muted-dark);
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    padding: 1.5rem;
    white-space: pre-wrap;
    line-height: 1.6;
    max-width: none;
  }
</style>

---
import { readdirSync } from 'fs'
import { resolve } from 'path'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionLabel from '../components/SectionLabel.astro'
import Stat from '../components/Stat.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import { partners } from '../data/partners'

let eventImages: string[] = []
try {
  const eventsDir = resolve('./public/events')
  eventImages = readdirSync(eventsDir)
    .filter(f => /\.(jpg|jpeg|png|webp|gif|avif)$/i.test(f))
    .map(f => `/events/${f}`)
} catch {
  // Directory doesn't exist — section hidden
}

// Team photo
let hasTeamPhoto = false
try {
  readdirSync('./public').includes('team.jpg') && (hasTeamPhoto = true)
} catch {}
---

<BaseLayout
  title="Globaal Elevate Production — kreativní skupina | Hudba, eventy, marketing"
  description="Globaal Elevate Production — kreativní skupina ze severních Čech. Pořádáme eventy a latino cluby v Chomutově (3lwave), rozvíjíme umělce a budujeme značky v oblasti marketingu a IT."
  lang="cs"
>

<!-- ═══════════════════════════════════════════
     HERO — navy surface, typographic, logo watermark
     ═══════════════════════════════════════════ -->
<section class="hero section" id="main-content">
  <!-- Logo watermark in background -->
  <div class="hero-watermark" aria-hidden="true">
    <img src="/logo-watermark.png" alt="" width="900" height="225" />
  </div>
  <div class="container">
    <p class="hero-label">
      Kreativní skupina · Severní Čechy
    </p>

    <h1 class="hero-h1 anim-fade">
      HUDBA.<br />
      EVENTY.<br />
      TECHNOLOGIE.
    </h1>
    {/* Záložní nadpis: "Stavíme značky, co mají skutečný základ" */}

    <div class="hero-bottom">
      <div class="hero-text">
        <p class="hero-lead">
          Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je kreativní skupina, která spojuje hudbu, kreativu a technologii pod jednou vizí.
        </p>
      </div>
      <div class="hero-cta">
        <a href="/portfolio" class="btn btn-primary">
          Prozkoumat portfolio <span class="btn-arrow">→</span>
        </a>
        <a href="/kontakt" class="btn btn-secondary">
          Konzultace zdarma
        </a>
      </div>
    </div>

    <div class="hero-stats-row hairline" style="padding-top:2rem;margin-top:2.5rem">
      <Stat value="2026" label="Rok vzniku" />
      <Stat value="4" label="Aktivní značky" />
      <Stat value="Praha · CZ" label="Sídlo" />
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     MARQUEE — only if partner logos exist
     ═══════════════════════════════════════════ -->
{partners.length > 0 && (
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...partners, ...partners].map(p => (
        <img src={p.logo} alt={p.name} />
      ))}
    </div>
  </div>
)}

<!-- ═══════════════════════════════════════════
     ZNAČKY — white surface, BrandRow table
     ═══════════════════════════════════════════ -->
<section class="section surface-white brands-section">
  <div class="container">
    <SectionLabel num="01" text="Portfolio" onLight />
    <h2 class="brands-h2 anim-fade">Naše značky</h2>

    <div class="brands-list anim-stagger" role="list">

      <a href="https://3lwave.cz" class="brand-row" role="listitem" target="_blank" rel="noopener">
        <span class="violet-sq" aria-hidden="true"></span>
        <span class="brand-row-num">01</span>
        <span class="brand-row-name">3lwave</span>
        <div class="brand-row-desc">
          <span class="brand-row-cat">Eventy</span>
          <p class="brand-row-text">Eventová značka nové generace — hudba, zážitky a propojení lidí. Pořádáme latino cluby a koncerty v severních Čechách.</p>
        </div>
        <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
      </a>

      <a href="#" class="brand-row" role="listitem" target="_blank" rel="noopener">
        <span class="violet-sq" aria-hidden="true"></span>
        <span class="brand-row-num">02</span>
        <span class="brand-row-name">Globaal Records</span>
        <div class="brand-row-desc">
          <span class="brand-row-cat">Hudba</span>
          <p class="brand-row-text">Nezávislý hudební label zaměřený na autentické umělce a originální zvuky. Distribuce, rozvoj a vydávání hudby.</p>
        </div>
        <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
      </a>

      <a href="#" class="brand-row" role="listitem" target="_blank" rel="noopener">
        <span class="violet-sq" aria-hidden="true"></span>
        <span class="brand-row-num">03</span>
        <span class="brand-row-name">Globaal Production</span>
        <div class="brand-row-desc">
          <span class="brand-row-cat">Kreativa</span>
          <p class="brand-row-text">Kreativní a marketingová agentura — branding, web development a telesales pro malé a střední firmy.</p>
        </div>
        <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
      </a>

      <a href="https://visiontechnology.cz" class="brand-row" role="listitem" target="_blank" rel="noopener">
        <span class="violet-sq" aria-hidden="true"></span>
        <span class="brand-row-num">04</span>
        <span class="brand-row-name">Vision Technology</span>
        <div class="brand-row-desc">
          <span class="brand-row-cat">Technologie</span>
          <p class="brand-row-text">AI systémy, weby a digitální vývoj na zakázku. Moderní technologická řešení pro firmy všech velikostí.</p>
        </div>
        <span class="brand-row-link">Navštívit <span class="arrow">→</span></span>
      </a>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     KDO JSME — ink surface
     ═══════════════════════════════════════════ -->
<section class="section about-section">
  <div class="container">
    <SectionLabel num="02" text="Kdo jsme" />

    <div class={`about-inner ${hasTeamPhoto ? 'about-has-photo' : 'about-no-photo'}`}>
      <div class="about-text">
        <p class="about-statement anim-fade">
          Globaal Elevate Production vznikl z reálné scény, ne z tabulky.
        </p>
        <div class="about-body anim-fade">
          <p>
            Než jsme se spojili v kreativní skupinu, byli jsme lidé kolem hudby a eventů v severních Čechách — a z toho zázemí jsme rostli do marketingové kreativity, vlastního IT vývoje a SaaS prostředků. Každý projekt pod námi řeší problém, který jsme sami zažili.
          </p>
          <p>
            Netvoříme pro portfolio. Tvoříme proto, že nás to baví a záleží nám na výsledku.
          </p>
        </div>
        <a href="/o-nas" class="btn btn-secondary" style="margin-top:2rem">
          Více o nás <span class="btn-arrow">→</span>
        </a>
      </div>

      {hasTeamPhoto && (
        <div class="about-photo">
          <img
            src="/team.jpg"
            alt="Tým Globaal Elevate Production"
            style="border-radius:var(--radius-img);width:100%;aspect-ratio:4/5;object-fit:cover;"
          />
        </div>
      )}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     Z AKCÍ — white, only if event photos exist
     ═══════════════════════════════════════════ -->
{eventImages.length > 0 && (
  <section class="section surface-white events-section">
    <div class="container">
      <SectionLabel num="03" text="Z akcí" onLight />
      <h2 class="anim-fade" style="color:var(--text-light);margin-bottom:3rem">Z akcí</h2>

      <div class="events-grid">
        {eventImages.map((src, i) => (
          <a href={src} class="event-item" data-lightbox="events">
            <img
              src={src}
              alt={`Fotka z akce ${i + 1}`}
              style="border-radius:var(--radius-img);width:100%;height:100%;object-fit:cover;"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ═══════════════════════════════════════════
     NEWSLETTER — grey-100 surface, single row
     ═══════════════════════════════════════════ -->
<section class="section nl-section surface-grey">
  <div class="container">
    <div class="nl-row">
      <div class="nl-copy">
        <h2 class="nl-h2">Newsletter</h2>
        <p class="nl-lead">Projekty, eventy, hudba a co se děje za kulisami — přímo do vaší schránky. Žádný spam.</p>
      </div>
      <div class="nl-form-wrap">
        <NewsletterSignup lang="cs" />
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     CTA — ink surface
     ═══════════════════════════════════════════ -->
<section class="section cta-section">
  <div class="container">
    <h2 class="cta-h2 anim-fade">Máte projekt?</h2>
    <p class="cta-lead anim-fade">
      Ať už jde o branding, hudbu nebo technologie — rádi si o tom promluvíme. Žádné formality, jen upřímný rozhovor.
    </p>
    <a href="/kontakt" class="btn btn-primary" style="margin-top:2.5rem">
      Kontaktovat nás <span class="btn-arrow">→</span>
    </a>
  </div>
</section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--navy);
    padding-top: 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-watermark {
    position: absolute;
    right: -80px;
    bottom: -20px;
    pointer-events: none;
    user-select: none;
    opacity: 1;
  }

  .hero-watermark img {
    width: 700px;
    height: auto;
    display: block;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted-dark);
    margin-bottom: 2.5rem;
    max-width: none;
  }

  .hero-h1 {
    color: var(--white);
    margin-bottom: 3.5rem;
    /* Fallback alt: "Stavíme značky, co mají skutečný základ" */
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: end;
    margin-bottom: 0;
  }

  .hero-lead {
    font-size: 1.0625rem;
    color: var(--muted-dark);
    line-height: 1.7;
    max-width: 52ch;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: .875rem;
    flex-shrink: 0;
  }

  .hero-stats-row {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  /* ── Brands ── */
  .brands-section { background: var(--white); }

  .brands-h2 {
    color: var(--text-light);
    margin-bottom: 3rem;
  }

  .brands-list {
    /* BrandRow styles in global.css */
  }

  /* ── About ── */
  .about-section { background: var(--navy); }

  .about-inner.about-has-photo {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 5rem;
    align-items: start;
  }

  .about-inner.about-no-photo {
    max-width: 720px;
  }

  .about-statement {
    font-family: var(--font);
    font-weight: 700;
    font-stretch: 100%;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.15;
    color: var(--text-dark);
    margin-bottom: 2rem;
    max-width: 22ch;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-body p {
    font-size: 1.0625rem;
    color: var(--muted-dark);
    line-height: 1.7;
  }

  /* ── Events ── */
  .events-section { background: var(--white); }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: .75rem;
  }

  .events-grid .event-item:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  .event-item {
    display: block;
    overflow: hidden;
  }

  /* ── Newsletter ── */
  .nl-section { background: var(--grey-100); }

  .nl-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .nl-h2 {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: .93;
    letter-spacing: -.01em;
    color: var(--text-light);
    margin-bottom: 1rem;
  }

  .nl-lead {
    font-size: 1rem;
    color: var(--muted-light);
    line-height: 1.6;
    max-width: 44ch;
  }

  /* ── CTA ── */
  .cta-section { background: var(--navy); }

  .cta-h2 {
    color: var(--white);
    margin-bottom: 1.5rem;
  }

  .cta-lead {
    font-size: 1.0625rem;
    color: var(--muted-dark);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-bottom { grid-template-columns: 1fr; gap: 2rem; }
    .hero-cta { flex-direction: row; }
    .about-inner.about-has-photo { grid-template-columns: 1fr; }
    .nl-row { grid-template-columns: 1fr; gap: 2rem; }
  }

  @media (max-width: 600px) {
    .hero { padding-top: 3rem; }
    .hero-cta { flex-direction: column; }
    .events-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
    }
    .events-grid .event-item:first-child {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>

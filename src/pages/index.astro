---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import SectionLabel from '../components/SectionLabel.astro'
import ImagePlaceholder from '../components/ImagePlaceholder.astro'
---

<BaseLayout
  title="Domů"
  description="Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je holding, který spojuje hudbu, kreativu a technologii pod jednou vizí."
  lang="cs"
>
  <!-- 1. Hero -->
  <Hero
    badge="• Kreativní holding"
    heading="Stavíme značky, co mají skutečný základ"
    accentPhrase="skutečný základ"
    lead="Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je holding, který spojuje hudbu, kreativu a technologii pod jednou vizí."
    ctaPrimary="Prozkoumat portfolio"
    ctaSecondary="Kontaktovat nás"
    ctaPrimaryHref="/portfolio"
    ctaSecondaryHref="/kontakt"
  />

  <!-- 2. Pilíře -->
  <section class="section pillars-section">
    <div class="container">
      <div class="pillars-header anim-fade">
        <SectionLabel text="Co děláme" />
        <h2 class="pillars-title">Tři pilíře naší práce</h2>
      </div>

      <div class="pillars-grid anim-stagger">
        <!-- Hudba -->
        <div class="card pillar-card">
          <div class="pillar-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </div>
          <h3>Hudba</h3>
          <p>Vydavatelství, distribuce a rozvoj umělců pod značkami 3lwave a Globaal Records. Zvuky pro novou generaci.</p>
        </div>
        <!-- Marketing -->
        <div class="card pillar-card">
          <div class="pillar-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 8.5c0 2.5-1.5 4.5-2.5 5.5L8 8.5V20.5"/>
              <path d="M2 8.5h6v6H2z"/>
              <path d="M8 11.5h14a0 0 0 0 0-14-3v6z"/>
            </svg>
          </div>
          <h3>Marketing</h3>
          <p>Strategický branding, digitální kampaně a obsahová tvorba. Budujeme značky, které zanechávají otisk.</p>
        </div>
        <!-- Produkce -->
        <div class="card pillar-card">
          <div class="pillar-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3>Produkce</h3>
          <p>Events, kreativní produkce a realizace projektů pod hlavičkou Globaal Production.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. O firmě — asymetrický layout -->
  <section class="section about-section">
    <div class="container">
      <div class="asym-grid anim-fade">
        <!-- Vlevo -->
        <div class="about-meta">
          <SectionLabel text="Kdo jsme" />
          <p class="about-date">Založeno 2026</p>
          <p class="about-meta-text">Praha, CZ</p>
        </div>
        <!-- Vpravo -->
        <div class="about-body">
          <h2 class="about-heading">Vyrostli jsme ze scény.</h2>
          <p class="about-text">
            Globaal Elevate Production vznikl z reálné scény, ne z tabulky. Než jsme byli holding, byli jsme lidi kolem hudby a eventů v severních Čechách — a z toho zázemí jsme rozrostli do marketingové kreativy, vlastního IT vývoje a SaaS produktů. Každá značka pod námi řeší problém, který jsme sami zažili.
          </p>
          <a href="/o-nas" class="btn btn-outline about-link">Více o nás →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Naše značky -->
  <section class="section brands-section">
    <div class="container">
      <div class="brands-header anim-fade">
        <SectionLabel text="Portfolio" />
        <h2 class="brands-title">Naše značky</h2>
      </div>

      <div class="brands-grid anim-stagger">
        <a href="https://3lwave.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-accent" style="background:#F59E0B"></div>
          <div class="brand-category">Eventy</div>
          <h3 class="brand-name">3lwave</h3>
          <p class="brand-desc">Eventová značka nové generace — hudba, zážitky a propojení lidí.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="https://3lwave.cz/label" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-accent" style="background:#ff6600"></div>
          <div class="brand-category">Hudba</div>
          <h3 class="brand-name">Globaal Records</h3>
          <p class="brand-desc">Nezávislé vydavatelství zaměřené na autentické umělce a originální zvuky.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="/portfolio" class="card brand-card">
          <div class="brand-accent" style="background:#6366f1"></div>
          <div class="brand-category">Kreativa</div>
          <h3 class="brand-name">Globaal Production</h3>
          <p class="brand-desc">Kreativní a marketingová agentura — branding, web development a telesales pro malé a střední firmy.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="https://visiontechnology.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-accent" style="background:#10b981"></div>
          <div class="brand-category">Technologie</div>
          <h3 class="brand-name">Vision Technology</h3>
          <p class="brand-desc">AI systémy, weby a digitální vývoj na zakázku.</p>
          <span class="brand-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Fotogalerie z eventů -->
  <section class="section events-section">
    <div class="container">
      <div class="events-header anim-fade">
        <SectionLabel text="3lwave — ze zákulisí" />
        <h2 class="events-title">Z akcí, které tvoříme</h2>
        <p class="events-lead">Přidejte fotky do <code>public/events/</code> a zobrazí se zde automaticky.</p>
      </div>
      <div class="events-grid anim-stagger">
        <ImagePlaceholder
          src="/events/event-1.jpg"
          alt="3lwave event — hlavní pódium"
          ratio="4/3"
          label="Foto z eventu"
          class="event-photo"
        />
        <ImagePlaceholder
          src="/events/event-2.jpg"
          alt="3lwave event — publikum"
          ratio="4/3"
          label="Foto z eventu"
          class="event-photo"
        />
        <ImagePlaceholder
          src="/events/event-3.jpg"
          alt="3lwave event — artists"
          ratio="4/3"
          label="Foto z eventu"
          class="event-photo"
        />
      </div>
    </div>
  </section>

  <!-- 6. CTA sekce -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner anim-fade">
        <h2 class="cta-heading">Máte projekt?<br />Pojďme na to.</h2>
        <p class="cta-lead">Ať už jde o branding, hudbu nebo technologii — rádi si o tom promluvíme.</p>
        <a href="/kontakt" class="btn btn-filled cta-btn">Kontaktovat nás</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Pillars */
  .pillars-section {
    background: var(--bg-surface);
  }

  .pillars-header {
    margin-bottom: 2.5rem;
  }

  .pillars-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* SVG icon wrapper */
  .pillar-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
    color: var(--accent);
    flex-shrink: 0;
  }

  .pillar-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .pillar-card p {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.65;
  }

  /* About */
  .about-section {
    background: var(--bg);
  }

  .about-meta {
    padding-top: 0.5rem;
  }

  .about-date {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-top: 1rem;
    font-weight: 500;
  }

  .about-meta-text {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-top: 0.25rem;
  }

  .about-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1.25rem;
  }

  .about-text {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .about-link {
    margin-top: 0.5rem;
  }

  /* Brands */
  .brands-section {
    background: var(--bg-surface);
  }

  .brands-header {
    margin-bottom: 2.5rem;
  }

  .brands-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    padding-top: 0.25rem;
  }

  /* Colored top accent stripe per brand */
  .brand-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    margin: -1.75rem -1.75rem 0;
    opacity: 0.8;
  }

  .brand-category {
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .brand-name {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .brand-desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    flex: 1;
  }

  .brand-arrow {
    font-size: 1.125rem;
    color: var(--fg-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
    margin-top: 0.5rem;
  }

  .brand-card:hover .brand-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Events gallery */
  .events-section {
    background: var(--bg);
  }

  .events-header {
    margin-bottom: 2.5rem;
  }

  .events-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 0.5rem;
  }

  .events-lead {
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  .events-lead code {
    font-family: 'Courier New', monospace;
    font-size: 0.8125rem;
    background: var(--bg-surface);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .event-photo {
    min-height: 200px;
  }

  /* CTA */
  .cta-section {
    background: #0A0A0A;
    padding: 6rem 0;
    border-top: 1px solid #252525;
  }

  .cta-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #F0F2F5;
    margin-bottom: 1rem;
  }

  .cta-lead {
    font-size: 1.0625rem;
    color: #8A919E;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .cta-btn {
    font-size: 1rem;
    padding: 0.875rem 2rem;
  }

  @media (max-width: 900px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .brands-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .section {
      padding: 3rem 0;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .brands-grid {
      grid-template-columns: 1fr 1fr;
    }

    .events-grid {
      grid-template-columns: 1fr;
    }

    .cta-heading {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
    }
  }

  @media (max-width: 400px) {
    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

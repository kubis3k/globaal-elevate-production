---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import SectionLabel from '../components/SectionLabel.astro'
---

<BaseLayout
  title="Domů"
  description="Globaal Elevate Production je kreativní holding formující novou éru brandingu, hudby a digitálního byznysu."
  lang="cs"
>
  <!-- 1. Hero -->
  <Hero
    badge="• Kreativní holding"
    heading="Stavíme značky, co mají skutečný základ."
    accentPhrase="skutečný základ"
    lead="Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem — Globaal Elevate Production je holding, který spojuje hudbu, kreativu a technologii pod jednou vizí."
    ctaPrimary="Prozkoumat portfolio"
    ctaSecondary="Kontaktovat nás"
    ctaPrimaryHref="/portfolio"
    ctaSecondaryHref="/kontakt"
  />

  <!-- 2. Pilíře -->
  <section class="section pillars-section">
    <div class="container">
      <div class="pillars-header anim-fade">
        <SectionLabel text="Co děláme" />
        <h2 class="pillars-title">Tři pilíře naší práce</h2>
      </div>

      <div class="pillars-grid anim-stagger">
        <div class="card pillar-card">
          <div class="pillar-icon">🎵</div>
          <h3>Hudba</h3>
          <p>Vydavatelství, distribuce a rozvoj umělců pod značkami 3lwave a Globaal Records. Zvuky pro novou generaci.</p>
        </div>
        <div class="card pillar-card">
          <div class="pillar-icon">📣</div>
          <h3>Marketing</h3>
          <p>Strategický branding, digitální kampaně a obsahová tvorba. Budujeme značky, které zanechávají otisk.</p>
        </div>
        <div class="card pillar-card">
          <div class="pillar-icon">⚡</div>
          <h3>Produkce</h3>
          <p>Events, kreativní produkce a realizace projektů pod hlavičkou Globaal Production.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. O firmě — asymetrický layout -->
  <section class="section about-section">
    <div class="container">
      <div class="asym-grid anim-fade">
        <!-- Vlevo -->
        <div class="about-meta">
          <SectionLabel text="Kdo jsme" />
          <p class="about-date">Založeno 2026</p>
          <p class="about-meta-text">Praha, CZ</p>
        </div>
        <!-- Vpravo -->
        <div class="about-body">
          <h2 class="about-heading">Vyrostli jsme ze scény.</h2>
          <p class="about-text">
            Globaal Elevate Production vznikl z reálné scény, ne z tabulky. Než jsme byli holding, byli jsme lidi kolem hudby a eventů v severních Čechách — a z toho zázemí jsme rozrostli do marketingové kreativy, vlastního IT vývoje a SaaS produktů. Každá značka pod námi řeší problém, který jsme sami zažili.
          </p>
          <a href="/o-nas" class="btn btn-outline about-link">Více o nás →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Naše značky -->
  <section class="section brands-section">
    <div class="container">
      <div class="brands-header anim-fade">
        <SectionLabel text="Portfolio" />
        <h2 class="brands-title">Naše značky</h2>
      </div>

      <div class="brands-grid anim-stagger">
        <a href="https://3lwave.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-category">Eventy</div>
          <h3 class="brand-name">3lwave</h3>
          <p class="brand-desc">Eventová značka nové generace — hudba, zážitky a propojení lidí.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="https://3lwave.cz/label" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-category">Hudba</div>
          <h3 class="brand-name">Globaal Records</h3>
          <p class="brand-desc">Nezávislé vydavatelství zaměřené na autentické umělce a originální zvuky.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="/portfolio" class="card brand-card">
          <div class="brand-category">Kreativa</div>
          <h3 class="brand-name">Globaal Production</h3>
          <p class="brand-desc">Kreativní a marketingová agentura — branding, web development a telesales pro malé a střední firmy.</p>
          <span class="brand-arrow">→</span>
        </a>
        <a href="https://visiontechnology.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
          <div class="brand-category">Technologie</div>
          <h3 class="brand-name">Vision Technology</h3>
          <p class="brand-desc">AI systémy, weby a digitální vývoj na zakázku.</p>
          <span class="brand-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. CTA sekce -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner anim-fade">
        <h2 class="cta-heading">Máte projekt?<br />Pojďme na to.</h2>
        <p class="cta-lead">Ať už jde o branding, hudbu nebo technologii — rádi si o tom promluvíme.</p>
        <a href="/kontakt" class="btn btn-filled cta-btn">Kontaktovat nás</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Pillars */
  .pillars-section {
    background: var(--bg);
  }

  .pillars-header {
    margin-bottom: 2.5rem;
  }

  .pillars-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pillar-icon {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .pillar-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .pillar-card p {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.65;
  }

  /* About */
  .about-section {
    background: var(--bg-surface);
  }

  .about-meta {
    padding-top: 0.5rem;
  }

  .about-date {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-top: 1rem;
    font-weight: 500;
  }

  .about-meta-text {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-top: 0.25rem;
  }

  .about-heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1.25rem;
  }

  .about-text {
    font-size: 1rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .about-link {
    margin-top: 0.5rem;
  }

  /* Brands */
  .brands-section {
    background: var(--bg);
  }

  .brands-header {
    margin-bottom: 2.5rem;
  }

  .brands-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-top: 0.5rem;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    position: relative;
  }

  .brand-category {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .brand-name {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .brand-desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    flex: 1;
  }

  .brand-arrow {
    font-size: 1.25rem;
    color: var(--fg-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
    margin-top: 0.5rem;
  }

  .brand-card:hover .brand-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* CTA */
  .cta-section {
    background: #0a0a0a;
    padding: 6rem 0;
    border-top: 1px solid #222222;
  }

  .cta-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #f5f5f5;
    margin-bottom: 1rem;
  }

  .cta-lead {
    font-size: 1.0625rem;
    color: #999999;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .cta-btn {
    font-size: 1rem;
    padding: 0.875rem 2rem;
  }

  @media (max-width: 900px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .brands-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

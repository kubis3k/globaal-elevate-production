---
import { readdirSync } from 'fs'
import { resolve } from 'path'
import BaseLayout from '../layouts/BaseLayout.astro'
import Pill from '../components/Pill.astro'
import SectionHeader from '../components/SectionHeader.astro'
import Stat from '../components/Stat.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import { partners } from '../data/partners'
import { stats } from '../data/stats'

let eventImages: string[] = []
try {
  const eventsDir = resolve('./public/events')
  eventImages = readdirSync(eventsDir)
    .filter(f => /\.(jpg|jpeg|png|webp|gif|avif)$/i.test(f))
    .map(f => `/events/${f}`)
} catch {
  // Directory doesn't exist — section hidden
}
---

<BaseLayout
  title="Globaal Elevate Production — kreativní skupina | Hudba, eventy, marketing"
  description="Globaal Elevate Production — kreativní skupina ze severních Čech. Pořádáme eventy a latino cluby v Chomutově (3lwave), rozvíjíme umělce a budujeme značky v oblasti marketingu a IT."
  lang="cs"
>

<!-- ═══════════════════════════════════════════════════════
     1. HERO — dark, grain + gold glow
═══════════════════════════════════════════════════════ -->
<section class="hero-section grain" aria-label="Úvod">
  <div class="glow-topleft" aria-hidden="true"></div>
  <div class="glow-bottomright" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content anim-fade">
      <Pill text="Kreativní skupina ze severních Čech" />

      <h1 class="hero-heading">
        Hudba, eventy a&nbsp;technologie.<br />
        <em class="accent-word">Pod jednou střechou.</em>
        <!-- Původní varianta: „Stavíme značky, co mají skutečný základ" -->
      </h1>

      <p class="hero-lead">
        Od severočeské rapové scény po firmy s vlastním IT a marketingovým motorem.
        Globaal Elevate Production spojuje hudbu, kreativu a technologii pod jednou vizí.
      </p>

      <div class="hero-cta">
        <a href="/portfolio" class="btn btn-primary">
          Prozkoumat portfolio
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/kontakt" class="btn btn-secondary">Kontaktovat nás</a>
      </div>

      <!-- Stat row — jen reálná čísla ze stats.ts -->
      <div class="hero-stats">
        {stats.map(s => (
          <Stat value={s.value} label={s.label} small />
        ))}
      </div>
    </div>

    <!-- Hero visual -->
    <div class="hero-visual anim-fade" aria-hidden="true">
      <div class="hero-card-wrap">
        {eventImages.length > 0 ? (
          <div class="hero-photo-card">
            <img
              src={eventImages[0]}
              alt="3lwave event"
              class="hero-photo"
              loading="eager"
              decoding="async"
            />
          </div>
        ) : (
          <div class="hero-placeholder-card">
            <!-- Geometric motif — placeholder until event photos are added -->
            <svg viewBox="0 0 320 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-geo" aria-hidden="true">
              <circle cx="160" cy="200" r="120" stroke="rgba(181,151,106,0.18)" stroke-width="1"/>
              <circle cx="160" cy="200" r="80" stroke="rgba(181,151,106,0.12)" stroke-width="1"/>
              <circle cx="160" cy="200" r="40" stroke="rgba(181,151,106,0.2)" stroke-width="1.5"/>
              <line x1="40" y1="200" x2="280" y2="200" stroke="rgba(181,151,106,0.10)" stroke-width="1"/>
              <line x1="160" y1="80" x2="160" y2="320" stroke="rgba(181,151,106,0.10)" stroke-width="1"/>
              <polygon points="160,100 220,200 160,300 100,200" stroke="rgba(181,151,106,0.15)" stroke-width="1" fill="none"/>
              <circle cx="160" cy="200" r="4" fill="rgba(181,151,106,0.5)"/>
              <text x="160" y="370" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.25)" font-family="monospace">TODO: přidejte fotky do public/events/</text>
            </svg>
          </div>
        )}
        <div class="hero-pill-float">
          <span class="float-dot" aria-hidden="true"></span>
          3lwave · Chomutov
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     2. PARTNER LOGOS — only if partners.ts has entries
═══════════════════════════════════════════════════════ -->
{partners.length > 0 && (
<section class="section partners-section section-dark" aria-label="Partneři">
  <div class="container">
    <p class="partners-label">Pracovali jsme s</p>
    <div class="partners-marquee" aria-hidden="true">
      <div class="marquee-track">
        {partners.map(p => (
          <a href={p.url ?? '#'} class="partner-logo-wrap" target="_blank" rel="noopener noreferrer" aria-label={p.name}>
            <img src={p.logo} alt={p.name} class="partner-logo" loading="lazy" />
          </a>
        ))}
        {/* Duplicate for seamless loop */}
        {partners.map(p => (
          <a href={p.url ?? '#'} class="partner-logo-wrap" target="_blank" rel="noopener noreferrer" aria-label={p.name} tabindex="-1">
            <img src={p.logo} alt="" class="partner-logo" loading="lazy" aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
)}

<!-- ═══════════════════════════════════════════════════════
     3. ZNAČKY — dark, cards overlapping hero
═══════════════════════════════════════════════════════ -->
<section class="section brands-section section-dark" aria-label="Naše značky" id="znacky">
  <div class="container">
    <SectionHeader
      pill="Portfolio"
      heading='Čtyři značky. <em class="accent-word">Jedna vize.</em>'
      class="anim-fade"
    />

    <div class="brands-grid anim-stagger">

      <a href="https://3lwave.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
        <span class="brand-num" aria-hidden="true">01</span>
        <span class="pill pill-sm" style="margin-bottom: 1rem;">Eventy</span>
        <h3 class="brand-name">3lwave</h3>
        <p class="brand-desc">Eventová značka nové generace — hudba, zážitky a propojení lidí. Pořádáme latino cluby a koncerty v severních Čechách.</p>
        <span class="brand-link" aria-hidden="true">Navštívit →</span>
      </a>

      <a href="https://3lwave.cz/label" target="_blank" rel="noopener noreferrer" class="card brand-card">
        <span class="brand-num" aria-hidden="true">02</span>
        <span class="pill pill-sm" style="margin-bottom: 1rem;">Hudba</span>
        <h3 class="brand-name">Globaal Records</h3>
        <p class="brand-desc">Nezávislé vydavatelství zaměřené na autentické umělce a originální zvuky. Distribuce, rozvoj a vydávání hudby.</p>
        <span class="brand-link" aria-hidden="true">Navštívit →</span>
      </a>

      <a href="/portfolio" class="card brand-card">
        <span class="brand-num" aria-hidden="true">03</span>
        <span class="pill pill-sm" style="margin-bottom: 1rem;">Kreativa</span>
        <h3 class="brand-name">Globaal Production</h3>
        <p class="brand-desc">Kreativní a marketingová agentura — branding, web development a telesales pro malé a střední firmy.</p>
        <span class="brand-link" aria-hidden="true">Navštívit →</span>
      </a>

      <a href="https://visiontechnology.cz" target="_blank" rel="noopener noreferrer" class="card brand-card">
        <span class="brand-num" aria-hidden="true">04</span>
        <span class="pill pill-sm" style="margin-bottom: 1rem;">Technologie</span>
        <h3 class="brand-name">Vision Technology</h3>
        <p class="brand-desc">AI systémy, weby a digitální vývoj na zakázku. Moderní technologická řešení pro firmy všech velikostí.</p>
        <span class="brand-link" aria-hidden="true">Navštívit →</span>
      </a>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     4. KDO JSME — light (paper)
═══════════════════════════════════════════════════════ -->
<section class="section section-light about-section" aria-label="Kdo jsme">
  <div class="container">
    <div class="about-grid">

      <!-- Left: text -->
      <div class="about-text-col anim-fade">
        <Pill text="Kdo jsme" />
        <h2 class="about-heading">
          Vyrostli jsme <em class="accent-word">ze scény.</em>
        </h2>
        <p class="about-body">
          Globaal Elevate Production vznikl z reálné scény, ne z tabulky. Než jsme se
          spojili v kreativní skupinu, byli jsme lidi kolem hudby a eventů v severních
          Čechách — a z toho zázemí jsme rozrostli do marketingové kreativy, vlastního
          IT vývoje a SaaS produktů. Každý projekt pod námi řeší problém, který jsme
          sami zažili.
        </p>
        <a href="/o-nas" class="btn btn-navy">
          Více o nás
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>

        <!-- Stats row -->
        <div class="about-stats">
          {stats.map(s => (
            <Stat value={s.value} label={s.label} small />
          ))}
          <Stat value="Praha · CZ" label="Sídlo" small />
        </div>
      </div>

      <!-- Right: photo slot -->
      <div class="about-visual-col anim-fade">
        <div class="about-photo-slot">
          <!--
            TODO: Doplňte fotografii týmu (formát 4:5, min. 800×1000 px).
            Fotka s reálnými lidmi je nejdůležitější prvek důvěry na webu.
            Vložte soubor do public/team.jpg a odkomentujte <img> níže.

            <img
              src="/team.jpg"
              alt="Tým Globaal Elevate Production"
              class="about-photo"
              width="480"
              height="600"
              loading="lazy"
            />
          -->
          <div class="about-photo-placeholder" aria-hidden="true">
            <span>TODO: fotka týmu 4:5</span>
          </div>
          <div class="about-float-card">
            <span class="float-dot" aria-hidden="true"></span>
            3lwave · Chomutov
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     5. Z AKCÍ — dark, only if event images exist
═══════════════════════════════════════════════════════ -->
{eventImages.length > 0 && (
<section class="section section-dark events-section" aria-label="Fotogalerie z akcí">
  <div class="container">
    <SectionHeader
      pill="3lwave · ze zákulisí"
      heading='Z akcí, které <em class="accent-word">tvoříme.</em>'
      class="anim-fade"
    />
    <div class="events-grid anim-stagger">
      {eventImages.map((src, i) => (
        <a href={src} class="event-photo-wrap" target="_blank" rel="noopener noreferrer" aria-label={`Foto z eventu ${i + 1}`}>
          <img
            src={src}
            alt={`3lwave event ${i + 1}`}
            class="event-photo"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>
)}

<!-- ═══════════════════════════════════════════════════════
     6. NEWSLETTER — dark inline section
═══════════════════════════════════════════════════════ -->
<section class="section section-dark newsletter-section" aria-label="Newsletter">
  <div class="container">
    <div class="nl-panel">
      <div class="glow-topleft" aria-hidden="true" style="width:400px;height:400px;top:-150px;left:-100px;"></div>
      <div class="nl-left">
        <Pill text="Newsletter" />
        <h2 class="nl-heading">
          Zůstaňte <em class="accent-word">v obraze.</em>
        </h2>
        <ul class="nl-benefits" role="list">
          <li>Projekty a eventy</li>
          <li>Nová hudba</li>
          <li>Za kulisami</li>
        </ul>
      </div>
      <div class="nl-right">
        <NewsletterSignup lang="cs" />
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     7. CTA — dark panel before footer
═══════════════════════════════════════════════════════ -->
<section class="section section-dark cta-section" aria-label="Kontakt">
  <div class="container">
    <div class="cta-panel anim-fade">
      <div class="glow-bottomright" aria-hidden="true" style="width:400px;height:400px;bottom:-120px;right:-80px;"></div>
      <h2 class="cta-heading">
        Máte projekt?
        <em class="accent-word">Pojďme na to.</em>
      </h2>
      <p class="cta-lead">
        Ať už jde o branding, hudbu nebo technologii — rádi si o tom promluvíme.
      </p>
      <a href="/kontakt" class="btn btn-primary cta-btn">
        Kontaktovat nás
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* ── HERO ───────────────────────────────────────────── */
.hero-section {
  background: var(--navy-900);
  padding: 120px 0 100px;
  position: relative;
  overflow: hidden;
  min-height: 90vh;
  display: flex;
  align-items: center;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  position: relative;
  z-index: 1;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.hero-content > * + * {
  margin-top: 1.5rem;
}

.hero-heading {
  font-size: clamp(2.5rem, 5vw, 4.25rem);
  line-height: 1.04;
  color: var(--text-on-dark);
  margin: 0;
}

.hero-lead {
  font-size: 1.125rem;
  color: var(--muted-on-dark);
  line-height: 1.75;
  max-width: 480px;
  margin: 0;
}

.hero-cta {
  display: flex;
  gap: 0.875rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}

.hero-stats {
  display: flex;
  gap: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--line);
  margin-top: 2rem;
}

/* Hero visual */
.hero-visual {
  display: flex;
  justify-content: flex-end;
}

.hero-card-wrap {
  position: relative;
  width: 100%;
  max-width: 380px;
}

.hero-photo-card {
  border-radius: 20px;
  overflow: hidden;
  transform: rotate(3deg);
  box-shadow: 0 40px 80px rgba(0,0,0,0.5);
  aspect-ratio: 3/4;
}

.hero-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-placeholder-card {
  border-radius: 20px;
  background: var(--navy-800);
  border: 1px solid var(--line);
  aspect-ratio: 3/4;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(3deg);
  overflow: hidden;
}

.hero-geo {
  width: 100%;
  height: 100%;
}

.hero-pill-float,
.about-float-card {
  position: absolute;
  bottom: -16px;
  left: -20px;
  background: var(--navy-800);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px 16px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-on-dark);
  display: flex;
  align-items: center;
  gap: 8px;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
}

.float-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold-500);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.8); }
}

/* ── PARTNERS / MARQUEE ─────────────────────────────── */
.partners-section {
  padding: 2.5rem 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.partners-label {
  font-size: 0.6875rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted-on-dark);
  opacity: 0.5;
  font-weight: 600;
  margin-bottom: 1.5rem;
  margin: 0 0 1.5rem;
}

.partners-marquee {
  overflow: hidden;
}

.marquee-track {
  display: flex;
  gap: 3rem;
  animation: marquee 30s linear infinite;
}

.marquee-track:hover { animation-play-state: paused; }

@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .marquee-track {
    animation: none;
    flex-wrap: wrap;
    justify-content: center;
  }
}

.partner-logo-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.partner-logo {
  height: 32px;
  width: auto;
  opacity: 0.5;
  filter: brightness(0) invert(1);
  transition: opacity 0.2s ease;
}

.partner-logo-wrap:hover .partner-logo { opacity: 0.9; }

/* ── BRANDS ─────────────────────────────────────────── */
.brands-section {
  padding-top: calc(var(--section-gap) + 4rem);
}

.brands-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}

.brand-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  padding: 2rem;
  min-height: 280px;
  position: relative;
}

.brand-num {
  position: absolute;
  top: 1.5rem;
  right: 1.75rem;
  font-size: 3rem;
  font-weight: 800;
  color: rgba(255,255,255,0.05);
  font-family: var(--font-sans);
  line-height: 1;
  letter-spacing: -0.04em;
  pointer-events: none;
  user-select: none;
}

.pill-sm {
  font-size: 0.6875rem;
  padding: 5px 12px;
  align-self: flex-start;
}

.brand-name {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-on-dark);
  margin-bottom: 0.75rem;
}

.brand-desc {
  font-size: 0.9375rem;
  color: var(--muted-on-dark);
  line-height: 1.65;
  flex: 1;
}

.brand-link {
  margin-top: 1.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--muted-on-dark);
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}

.brand-card:hover .brand-link {
  color: var(--gold-400);
  transform: translateX(4px);
}

/* ── KDO JSME ───────────────────────────────────────── */
.about-section {
  position: relative;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.about-text-col {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.about-heading {
  font-size: clamp(2rem, 3.4vw, 2.75rem);
  color: var(--ink-text);
  margin: 0;
}

.about-body {
  font-size: 1.0625rem;
  color: #5a6478;
  line-height: 1.8;
  margin: 0;
}

.about-stats {
  display: flex;
  gap: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(14, 20, 40, 0.1);
  flex-wrap: wrap;
}

/* Photo slot */
.about-visual-col {
  display: flex;
  justify-content: center;
}

.about-photo-slot {
  position: relative;
  width: 100%;
  max-width: 420px;
}

.about-photo {
  width: 100%;
  height: auto;
  border-radius: 24px;
  display: block;
  object-fit: cover;
}

.about-photo-placeholder {
  aspect-ratio: 4/5;
  border-radius: 24px;
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
  border: 1px dashed rgba(14, 20, 40, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-photo-placeholder span {
  font-size: 0.8125rem;
  color: rgba(14,20,40,0.3);
  font-family: monospace;
}

/* Production: hide placeholder text */
:global(html:not([data-dev])) .about-photo-placeholder span {
  display: none;
}

.about-float-card {
  bottom: 24px;
  left: -24px;
  background: var(--paper-card);
  border: 1px solid rgba(14, 20, 40, 0.12);
  color: var(--ink-text);
}

/* ── Z AKCÍ ─────────────────────────────────────────── */
.events-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-auto-rows: 260px;
  gap: 1rem;
}

.events-grid .event-photo-wrap:first-child {
  grid-row: 1 / 3;
}

.event-photo-wrap {
  display: block;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid var(--line);
  transition: border-color 0.2s ease;
}

.event-photo-wrap:hover {
  border-color: rgba(181, 151, 106, 0.5);
}

.event-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.event-photo-wrap:hover .event-photo {
  transform: scale(1.04);
}

/* ── NEWSLETTER PANEL ───────────────────────────────── */
.nl-panel {
  background: var(--navy-800);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 3.5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.nl-left {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  position: relative;
  z-index: 1;
}

.nl-heading {
  font-size: clamp(1.75rem, 2.5vw, 2.5rem);
  color: var(--text-on-dark);
  margin: 0;
}

.nl-benefits {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}

.nl-benefits li {
  font-size: 0.9375rem;
  color: var(--muted-on-dark);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 0;
}

.nl-benefits li::before {
  content: '';
  display: block;
  width: 16px;
  height: 1.5px;
  background: var(--gold-500);
  flex-shrink: 0;
}

.nl-right {
  position: relative;
  z-index: 1;
}

/* ── CTA PANEL ──────────────────────────────────────── */
.cta-panel {

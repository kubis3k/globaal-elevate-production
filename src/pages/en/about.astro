---
import PageLayout from '../../layouts/PageLayout.astro'
import SectionLabel from '../../components/SectionLabel.astro'
---

<PageLayout
  title="About"
  description="Globaal Elevate Production — a holding that grew from a real scene. Music, creativity and technology under one vision."
  badge="• Who we are"
  heading="We grew out of the scene."
  lead="Before we were a holding, we were people around music and events in northern Bohemia."
  lang="en"
>
  <!-- Mission -->
  <section class="section">
    <div class="container">
      <div class="asym-grid anim-fade">
        <div>
          <SectionLabel text="Our mission" />
          <p class="meta-text">Since 2026</p>
        </div>
        <div class="mission-body">
          <h2 class="section-heading">From a real scene to a holding</h2>
          <p class="body-text">
            Globaal Elevate Production was born from a real scene, not a spreadsheet. Before we were a holding, we were people around music and events in northern Bohemia — and from that foundation we grew into marketing and creative work, our own IT development and SaaS products.
          </p>
          <p class="body-text">
            Every brand under us solves a problem we lived through ourselves. Based in Prague, rooted in the north.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section values-section">
    <div class="container">
      <div class="anim-fade">
        <SectionLabel text="Our values" />
        <h2 class="section-heading">What drives us</h2>
      </div>

      <div class="values-grid anim-stagger">
        <div class="value-item">
          <div class="value-number">01</div>
          <h3>Scene as foundation</h3>
          <p>We started at music events in northern Bohemia. Experience in logistics, promotion and audiences is embedded in every project we build today.</p>
        </div>
        <div class="value-item">
          <div class="value-number">02</div>
          <h3>Own problem, own solution</h3>
          <p>Globaal Production was created because we couldn't find decent branding at a fair price. Every brand under us solves a problem we experienced ourselves.</p>
        </div>
        <div class="value-item">
          <div class="value-number">03</div>
          <h3>Connected, not isolated</h3>
          <p>Events via 3lwave, creative via Globaal Production, technology via Vision Technology — every GEP brand can draw on the capacity of the others. A system, not a coincidence.</p>
        </div>
        <div class="value-item">
          <div class="value-number">04</div>
          <h3>Numbers over slogans</h3>
          <p>We don't measure success in followers. We measure it in projects that stand — events that sold out, websites that convert, clients who came back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section founder-section">
    <div class="container">
      <div class="founder-inner anim-fade">
        <div class="founder-photo">
          <img src="/zakladatel.jpg" alt="Jakub Lučan — founder of Globaal Elevate Production" class="founder-img" onerror="this.parentElement.classList.add('no-photo')" />
          <div class="founder-placeholder">JL</div>
        </div>
        <div class="founder-text">
          <SectionLabel text="Founder" />
          <h2 class="founder-name">Jakub Lučan</h2>
          <p class="founder-role">Founder & CEO, Globaal Elevate Production</p>
          <p class="founder-bio">
            I didn't found Globaal Elevate Production as a business plan. It started with music, friends and events in northern Bohemia — and gradually became something more. Today we bring creativity, technology and music together under one roof, because I believe these worlds belong together. Every brand we launch solves a problem I experienced myself.
          </p>
          <a href="/en/contact" class="btn btn-outline founder-cta">Get in touch →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="section">
    <div class="container">
      <div class="anim-fade">
        <SectionLabel text="Portfolio" />
        <h2 class="section-heading">Our projects</h2>
      </div>

      <div class="brands-list anim-stagger">
        <a href="https://3lwave.cz" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Events</span>
            <strong>3lwave</strong>
          </div>
          <p>Next-generation event brand — music, experiences and connecting people.</p>
          <span class="arrow">→</span>
        </a>
        <a href="https://3lwave.cz/label" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Music</span>
            <strong>Globaal Records</strong>
          </div>
          <p>Independent label focused on authentic artists and original sounds.</p>
          <span class="arrow">→</span>
        </a>
        <a href="/en/portfolio" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Creative</span>
            <strong>Globaal Production</strong>
          </div>
          <p>Creative and marketing agency — branding, web development and telesales for SMBs.</p>
          <span class="arrow">→</span>
        </a>
        <a href="https://visiontechnology.cz" target="_blank" rel="noopener noreferrer" class="card brand-row">
          <div class="brand-info">
            <span class="brand-tag">Technology</span>
            <strong>Vision Technology</strong>
          </div>
          <p>Custom development of AI systems, websites and digital products.</p>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .section-heading { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-top: 0.5rem; margin-bottom: 1.5rem; }
  .meta-text { font-size: 0.8125rem; color: var(--fg-muted); margin-top: 1rem; }
  .body-text { font-size: 1rem; color: var(--fg-muted); line-height: 1.75; margin-bottom: 1rem; }
  .mission-body { max-width: 640px; }

  .values-section { background: var(--bg-surface); }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .value-item { padding: 2rem 2rem 2rem 0; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.5rem; }
  .value-item:nth-child(odd) { padding-right: 3rem; border-right: 1px solid var(--border); }
  .value-item:nth-child(even) { padding-left: 3rem; padding-right: 0; }
  .value-number { font-size: 0.6875rem; font-weight: 700; color: var(--fg-muted); letter-spacing: 0.15em; margin-bottom: 0.25rem; }
  .value-item h3 { font-size: 1.0625rem; font-weight: 700; }
  .value-item p { font-size: 0.9rem; color: var(--fg-muted); line-height: 1.65; }

  .founder-section { background: var(--bg); }
  .founder-inner { display: grid; grid-template-columns: 200px 1fr; gap: 3rem; align-items: start; }
  .founder-photo { position: relative; }
  .founder-img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 0.75rem; border: 1px solid var(--border); }
  .founder-placeholder { display: none; width: 100%; aspect-ratio: 1; border-radius: 0.75rem; background: var(--bg-surface); border: 1px solid var(--border); align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; color: var(--fg-muted); }
  .founder-photo.no-photo .founder-img { display: none; }
  .founder-photo.no-photo .founder-placeholder { display: flex; }
  .founder-name { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0.5rem 0 0.25rem; }
  .founder-role { font-size: 0.875rem; color: var(--fg-muted); margin-bottom: 1.25rem; font-weight: 500; }
  .founder-bio { font-size: 1rem; color: var(--fg-muted); line-height: 1.75; margin-bottom: 1.5rem; }
  @media (max-width: 640px) { .founder-inner { grid-template-columns: 1fr; } .founder-photo { width: 120px; } }

  .brands-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }

  .brand-row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
  }

  .brand-info { display: flex; flex-direction: column; gap: 0.25rem; }
  .brand-tag { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .brand-info strong { font-size: 1.125rem; font-weight: 700; }
  .brand-row p { font-size: 0.9rem; color: var(--fg-muted); }
  .arrow { font-size: 1.25rem; color: var(--fg-muted); transition: color 0.2s ease, transform 0.2s ease; display: inline-block; }
  .brand-row:hover .arrow { color: var(--accent); transform: translateX(4px); }

  @media (max-width: 640px) {
    .values-grid { grid-template-columns: 1fr; }
    .value-item:nth-child(odd) { border-right: none; padding-right: 0; }
    .value-item:nth-child(even) { padding-left: 0; }
    .brand-row { grid-template-columns: 1fr auto; grid-template-rows: auto auto; }
    .brand-row p { grid-column: 1; }
  }
</style>

---
import { getCollection } from 'astro:content'
import PageLayout from '../../layouts/PageLayout.astro'

const posts = (await getCollection('blog'))
  .filter(p => p.data.lang === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
}
---

<PageLayout
  title="News"
  description="News and updates from Globaal Elevate Production — new projects, partnerships and insights from across the holding."
  badge="• Blog"
  heading="News"
  lead="What's happening at Globaal Elevate Production — new projects, insights and updates."
  lang="en"
>
  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="empty">No posts yet.</p>
      ) : (
        <div class="posts-grid anim-stagger">
          {posts.map(post => (
            <a href={`/en/news/${post.slug}`} class="card post-card">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="post-tag">{post.data.tags[0]}</span>
                )}
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-excerpt">{post.data.excerpt}</p>
              <span class="post-arrow">Read more →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</PageLayout>

<style>
  .posts-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .post-card { display: flex; flex-direction: column; gap: 0.75rem; text-decoration: none; }
  .post-meta { display: flex; align-items: center; gap: 0.75rem; }
  .post-meta time { font-size: 0.8125rem; color: var(--fg-muted); }
  .post-tag { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .post-title { font-size: 1.375rem; font-weight: 700; line-height: 1.3; }
  .post-excerpt { font-size: 0.9375rem; color: var(--fg-muted); line-height: 1.65; flex: 1; }
  .post-arrow { font-size: 0.875rem; color: var(--accent); font-weight: 600; transition: transform 0.2s ease; display: inline-block; }
  .post-card:hover .post-arrow { transform: translateX(4px); }
  .empty { color: var(--fg-muted); font-size: 1rem; }
  @media (max-width: 640px) { .posts-grid { grid-template-columns: 1fr; } }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Stránka nenalezena"
  description="Hledaná stránka neexistuje nebo byla přesunuta."
  lang="cs"
>
  <section class="not-found">
    <div class="container nf-inner">
      <div class="nf-code">404</div>
      <h1 class="nf-heading">Stránka nenalezena</h1>
      <p class="nf-lead">Tato adresa neexistuje nebo byla přesunuta. Zkontrolujte odkaz nebo se vraťte na úvod.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-filled">Zpět na úvod</a>
        <a href="/kontakt" class="btn btn-outline">Kontaktovat nás</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    background: var(--bg);
    padding: 6rem 0;
  }

  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 560px;
  }

  .nf-code {
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--border);
    font-variant-numeric: tabular-nums;
    user-select: none;
  }

  .nf-heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }

  .nf-lead {
    font-size: 1.0625rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin: 0;
  }

  .nf-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
</style>

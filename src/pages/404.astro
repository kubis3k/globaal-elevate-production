---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Stránka nenalezena — Globaal Elevate"
  description="Požadovaná stránka neexistuje nebo byla přesunuta."
  locale="cs"
  path="/404"
  noindex={true}
>
  <div class="mx-auto max-w-content px-4 py-24 text-center sm:px-6">
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">Stránka nenalezena</h1>
    <p class="mt-4 text-lg text-muted">
      Omlouváme se, hledaná stránka neexistuje nebo byla přesunuta.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-md bg-accent px-5 py-2.5 font-medium text-paper transition-opacity hover:opacity-90"
    >
      Zpět na hlavní stránku
    </a>
  </div>
</BaseLayout>

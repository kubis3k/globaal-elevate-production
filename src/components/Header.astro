---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'

// Logo: logo.png has no alpha channel (all-white pixels, no transparency).
// The filter brightness(0) invert(1) produces a solid white rectangle.
// TEMPORARY: text-based logo. Provide logo-transparent.png or logo.svg for production.
// See output #7 in the brief.

const nav = isEn
  ? [
      { href: '/en/', label: 'Home' },
      { href: '/en/o-nas', label: 'About' },
      { href: '/en/portfolio', label: 'Portfolio' },
      { href: '/en/novinky', label: 'News' },
      { href: '/en/kontakt', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Domů' },
      { href: '/o-nas', label: 'O nás' },
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/novinky', label: 'Novinky' },
      { href: '/kontakt', label: 'Kontakt' },
    ]

const currentPath = Astro.url.pathname
---

<a href="#main-content" class="skip-link">
  {isEn ? 'Skip to content' : 'Přejít na obsah'}
</a>

<header class="site-header" id="site-header">
  <div class="header-inner container">

    <!-- Logo -->
    <a href={isEn ? '/en/' : '/'} class="logo-link" aria-label={isEn ? 'Globaal Elevate — Home' : 'Globaal Elevate — Domů'}>
      <!-- Text fallback: see comment above about logo.png transparency issue -->
      <span class="logo-wordmark" aria-hidden="false">
        <span class="logo-g">GE</span><span class="logo-rest">P</span>
      </span>
      <span class="logo-name">Globaal Elevate</span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label={isEn ? 'Main navigation' : 'Hlavní navigace'}>
      {nav.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && item.href !== '/en/' && currentPath.startsWith(item.href))
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'is-active' : ''}`} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        )
      })}
    </nav>

    <!-- Right group -->
    <div class="header-actions">
      <!-- Language switcher -->
      <div class="lang-switcher" aria-label="Jazyk / Language">
        {isEn
          ? <>
              <a href={currentPath.replace(/^\/en/, '') || '/'} class="lang-link" lang="cs">CS</a>
              <span class="lang-div" aria-hidden="true">/</span>
              <span class="lang-current" lang="en" aria-current="true">EN</span>
            </>
          : <>
              <span class="lang-current" lang="cs" aria-current="true">CS</span>
              <span class="lang-div" aria-hidden="true">/</span>
              <a href={`/en${currentPath}`} class="lang-link" lang="en">EN</a>
            </>
        }
      </div>

      <a href="https://portal.globaalelevate.com" class="portal-link" target="_blank" rel="noopener">
        {isEn ? 'Client portal' : 'Klientský portál'} ↗
      </a>

      <a href={isEn ? '/en/kontakt' : '/kontakt'} class="btn btn-primary">
        {isEn ? 'Get in touch' : 'Napište nám'} <span class="btn-arrow">→</span>
      </a>

      <!-- Hamburger -->
      <button class="hamburger" id="hamburger" aria-label={isEn ? 'Open menu' : 'Otevřít menu'} aria-expanded="false" aria-controls="nav-mobile">
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav -->
<div class="nav-mobile" id="nav-mobile" hidden aria-label={isEn ? 'Mobile navigation' : 'Mobilní navigace'} role="dialog" aria-modal="true">
  <div class="nav-mobile-inner">
    <div class="nav-mobile-header">
      <span class="logo-wordmark" aria-hidden="true"><span class="logo-g">GE</span><span class="logo-rest">P</span></span>
      <button class="nav-close" id="nav-close" aria-label={isEn ? 'Close menu' : 'Zavřít menu'}>✕</button>
    </div>

    <nav class="nav-mobile-links" aria-label={isEn ? 'Mobile navigation' : 'Mobilní navigace'}>
      {nav.map(item => (
        <a href={item.href} class="nav-mobile-link">{item.label}</a>
      ))}
    </nav>

    <div class="nav-mobile-footer">
      <a href={isEn ? '/en/kontakt' : '/kontakt'} class="btn btn-primary" style="width:100%;justify-content:center">
        {isEn ? 'Get in touch' : 'Napište nám'} <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  const header    = document.getElementById('site-header')!
  const hamburger = document.getElementById('hamburger')!
  const navClose  = document.getElementById('nav-close')!
  const navMobile = document.getElementById('nav-mobile')!

  // Scroll: shrink header
  const scrollHandler = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 40)
  }
  window.addEventListener('scroll', scrollHandler, { passive: true })
  scrollHandler()

  // Mobile menu open
  const openMenu = () => {
    navMobile.hidden = false
    hamburger.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    // Focus first link
    const firstLink = navMobile.querySelector<HTMLElement>('.nav-mobile-link')
    firstLink?.focus()
  }

  const closeMenu = () => {
    navMobile.hidden = true
    hamburger.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    hamburger.focus()
  }

  hamburger.addEventListener('click', openMenu)
  navClose.addEventListener('click', closeMenu)

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !navMobile.hidden) closeMenu()
  })

  // Focus trap
  navMobile.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return
    const focusable = navMobile.querySelectorAll<HTMLElement>(
      'a, button, input, [tabindex]:not([tabindex="-1"])'
    )
    const first = focusable[0]
    const last  = focusable[focusable.length - 1]
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus()
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus()
    }
  })

  // Close on nav link click
  navMobile.querySelectorAll('.nav-mobile-link').forEach(link => {
    link.addEventListener('click', closeMenu)
  })
</script>

<style>
  /* ── Header shell ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: var(--ink);
    border-bottom: 1px solid var(--line-dark);
    height: 72px;
    transition: height 0.2s ease;
  }

  .site-header.is-scrolled { height: 56px; }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 2rem;
  }

  /* ── Logo ── */
  .logo-link {
    display: flex;
    align-items: center;
    gap: .625rem;
    flex-shrink: 0;
    color: var(--white);
    text-decoration: none;
  }

  .logo-wordmark {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: -.02em;
    line-height: 1;
    color: var(--white);
  }

  .logo-g { color: var(--violet-400); }
  .logo-rest { color: var(--white); opacity: .6; }

  .logo-name {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted-dark);
  }

  /* ── Desktop nav ── */
  .nav-desktop {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-family: var(--font);
    font-weight: 500;
    font-stretch: 100%;
    font-size: 14px;
    color: var(--muted-dark);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover { color: var(--white); }
  .nav-link.is-active { color: var(--white); border-bottom-color: var(--violet-600); }
  .nav-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  /* ── Actions ── */
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Lang switcher */
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: .375rem;
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .lang-link {
    color: var(--muted-dark);
    text-decoration: none;
    transition: color 0.15s;
  }
  .lang-link:hover { color: var(--white); }

  .lang-current { color: var(--white); }
  .lang-div { color: var(--line-dark); }

  /* Portal link */
  .portal-link {
    font-family: var(--font);
    font-weight: 500;
    font-stretch: 100%;
    font-size: 13px;
    color: var(--muted-dark);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .portal-link:hover { color: var(--white); }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    padding: 0 2px;
    cursor: pointer;
  }

  .ham-line {
    display: block;
    height: 1.5px;
    background: var(--white);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .hamburger:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  /* ── Mobile nav ── */
  .nav-mobile {
    position: fixed;
    inset: 0;
    background: var(--ink);
    z-index: 200;
    display: flex;
    flex-direction: column;
  }

  .nav-mobile[hidden] { display: none; }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem var(--pad);
  }

  .nav-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-dark);
    margin-bottom: 2rem;
  }

  .nav-close {
    background: none;
    border: none;
    color: var(--white);
    font-size: 20px;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .nav-mobile-link {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(2rem, 8vw, 2.75rem);
    text-transform: uppercase;
    line-height: 1;
    color: var(--white);
    text-decoration: none;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line-dark);
    transition: color 0.15s ease;
    letter-spacing: -.01em;
  }

  .nav-mobile-link:hover { color: var(--violet-400); }
  .nav-mobile-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  .nav-mobile-footer {
    padding-top: 2rem;
  }

  /* ── Responsive breakpoints ── */
  @media (max-width: 1024px) {
    .portal-link { display: none; }
    .nav-desktop { gap: 1.25rem; }
  }

  @media (max-width: 768px) {
    .nav-desktop { display: none; }
    .hamburger { display: flex; }
    .header-actions .btn { display: none; }
    .lang-switcher { display: none; }
  }
</style>

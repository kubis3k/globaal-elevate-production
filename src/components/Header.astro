---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'

const nav = isEn
  ? [
      { href: '/en/', label: 'Home' },
      { href: '/en/o-nas', label: 'About' },
      { href: '/en/portfolio', label: 'Portfolio' },
      { href: '/en/novinky', label: 'News' },
      { href: '/en/kontakt', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Domů' },
      { href: '/o-nas', label: 'O nás' },
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/novinky', label: 'Novinky' },
      { href: '/kontakt', label: 'Kontakt' },
    ]

const currentPath = Astro.url.pathname
---

<a href="#main-content" class="skip-link">
  {isEn ? 'Skip to content' : 'Přejít na obsah'}
</a>

<!-- Pre-header: Instagram + contact, hides on scroll -->
<div class="pre-header" id="pre-header">
  <div class="pre-header-inner container">
    <a
      href="https://instagram.com/globaalelevate"
      class="pre-header-ig"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram @globaalelevate"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
      </svg>
      @globaalelevate
    </a>
    <div class="pre-header-contact">
      <a href="mailto:info@globaalelevate.com" class="pre-header-link">
        info@globaalelevate.com
      </a>
      <span class="pre-header-sep" aria-hidden="true">·</span>
      <a href="https://portal.globaalelevate.com" class="pre-header-link" target="_blank" rel="noopener">
        {isEn ? 'Client portal' : 'Klientský portál'} ↗
      </a>
    </div>
  </div>
</div>

<!-- Main sticky header -->
<header class="site-header" id="site-header">
  <div class="header-inner container">

    <!-- Logo -->
    <a href={isEn ? '/en/' : '/'} class="logo-link" aria-label={isEn ? 'Globaal Elevate — Home' : 'Globaal Elevate — Domů'}>
      <img src="/logo-white.png" alt="Globaal Elevate Production" class="logo-img" width="120" height="30" />
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label={isEn ? 'Main navigation' : 'Hlavní navigace'}>
      {nav.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && item.href !== '/en/' && currentPath.startsWith(item.href))
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'is-active' : ''}`} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        )
      })}
    </nav>

    <!-- Right group -->
    <div class="header-actions">
      <!-- Language switcher -->
      <div class="lang-switcher" aria-label="Jazyk / Language">
        {isEn
          ? <>
              <a href={currentPath.replace(/^\/en/, '') || '/'} class="lang-link" lang="cs">CS</a>
              <span class="lang-div" aria-hidden="true">/</span>
              <span class="lang-current" lang="en" aria-current="true">EN</span>
            </>
          : <>
              <span class="lang-current" lang="cs" aria-current="true">CS</span>
              <span class="lang-div" aria-hidden="true">/</span>
              <a href={`/en${currentPath}`} class="lang-link" lang="en">EN</a>
            </>
        }
      </div>

      <a href={isEn ? '/en/kontakt' : '/kontakt'} class="btn btn-primary">
        {isEn ? 'Get in touch' : 'Napište nám'} <span class="btn-arrow">→</span>
      </a>

      <!-- Hamburger -->
      <button class="hamburger" id="hamburger" aria-label={isEn ? 'Open menu' : 'Otevřít menu'} aria-expanded="false" aria-controls="nav-mobile">
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav -->
<div class="nav-mobile" id="nav-mobile" hidden aria-label={isEn ? 'Mobile navigation' : 'Mobilní navigace'} role="dialog" aria-modal="true">
  <div class="nav-mobile-inner">
    <div class="nav-mobile-header">
      <img src="/logo-white.png" alt="Globaal Elevate Production" class="logo-img" width="100" height="25" />
      <button class="nav-close" id="nav-close" aria-label={isEn ? 'Close menu' : 'Zavřít menu'}>✕</button>
    </div>

    <nav class="nav-mobile-links" aria-label={isEn ? 'Mobile navigation' : 'Mobilní navigace'}>
      {nav.map(item => (
        <a href={item.href} class="nav-mobile-link">{item.label}</a>
      ))}
    </nav>

    <div class="nav-mobile-footer">
      <a href={isEn ? '/en/kontakt' : '/kontakt'} class="btn btn-primary" style="width:100%;justify-content:center">
        {isEn ? 'Get in touch' : 'Napište nám'} <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<script>
  const header     = document.getElementById('site-header')!
  const preHeader  = document.getElementById('pre-header')!
  const hamburger  = document.getElementById('hamburger')!
  const navClose   = document.getElementById('nav-close')!
  const navMobile  = document.getElementById('nav-mobile')!

  // Scroll: hide pre-header, shrink main header
  const scrollHandler = () => {
    const scrolled = window.scrollY > 8
    preHeader.classList.toggle('hidden', scrolled)
    header.classList.toggle('is-scrolled', window.scrollY > 40)
  }
  window.addEventListener('scroll', scrollHandler, { passive: true })
  scrollHandler()

  // Mobile menu open
  const openMenu = () => {
    navMobile.hidden = false
    hamburger.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    const firstLink = navMobile.querySelector<HTMLElement>('.nav-mobile-link')
    firstLink?.focus()
  }

  const closeMenu = () => {
    navMobile.hidden = true
    hamburger.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    hamburger.focus()
  }

  hamburger.addEventListener('click', openMenu)
  navClose.addEventListener('click', closeMenu)

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !navMobile.hidden) closeMenu()
  })

  navMobile.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return
    const focusable = navMobile.querySelectorAll<HTMLElement>(
      'a, button, input, [tabindex]:not([tabindex="-1"])'
    )
    const first = focusable[0]
    const last  = focusable[focusable.length - 1]
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus()
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus()
    }
  })

  navMobile.querySelectorAll('.nav-mobile-link').forEach(link => {
    link.addEventListener('click', closeMenu)
  })
</script>

<style>
  /* ── Pre-header ── */
  .pre-header {
    background: var(--navy);
    border-bottom: 1px solid rgba(255,255,255,.06);
    height: 36px;
    overflow: hidden;
    transition: height 0.25s ease, opacity 0.25s ease;
  }

  .pre-header.hidden {
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .pre-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .pre-header-ig {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,.55);
    text-decoration: none;
    transition: color 0.15s;
  }
  .pre-header-ig:hover { color: var(--violet-400); }

  .pre-header-contact {
    display: flex;
    align-items: center;
    gap: .75rem;
    font-family: var(--font);
    font-size: 12px;
  }

  .pre-header-link {
    color: rgba(255,255,255,.55);
    text-decoration: none;
    transition: color 0.15s;
  }
  .pre-header-link:hover { color: rgba(255,255,255,.9); }

  .pre-header-sep { color: rgba(255,255,255,.2); }

  /* ── Header shell ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: var(--navy);
    border-bottom: 1px solid rgba(255,255,255,.08);
    height: 68px;
    transition: height 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    height: 56px;
    background: rgba(13, 9, 40, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(255,255,255,.06), 0 4px 24px rgba(0,0,0,.4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 2rem;
  }

  /* ── Logo ── */
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-img {
    height: 26px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    display: block;
  }

  /* ── Desktop nav ── */
  .nav-desktop {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-family: var(--font);
    font-weight: 500;
    font-stretch: 100%;
    font-size: 14px;
    color: rgba(255,255,255,.6);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover { color: var(--white); }
  .nav-link.is-active { color: var(--white); border-bottom-color: var(--violet-500); }
  .nav-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  /* ── Actions ── */
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: .375rem;
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .lang-link { color: rgba(255,255,255,.5); text-decoration: none; transition: color 0.15s; }
  .lang-link:hover { color: var(--white); }
  .lang-current { color: var(--white); }
  .lang-div { color: rgba(255,255,255,.2); }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    padding: 0 2px;
    cursor: pointer;
  }

  .ham-line {
    display: block;
    height: 1.5px;
    background: var(--white);
    border-radius: 1px;
  }

  .hamburger:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  /* ── Mobile nav ── */
  .nav-mobile {
    position: fixed;
    inset: 0;
    background: var(--navy);
    z-index: 200;
    display: flex;
    flex-direction: column;
  }

  .nav-mobile[hidden] { display: none; }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem var(--pad);
  }

  .nav-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,.08);
    margin-bottom: 2rem;
  }

  .nav-close {
    background: none;
    border: none;
    color: var(--white);
    font-size: 20px;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .nav-mobile-link {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(2rem, 8vw, 2.75rem);
    text-transform: uppercase;
    line-height: 1;
    color: var(--white);
    text-decoration: none;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255,255,255,.08);
    transition: color 0.15s ease;
    letter-spacing: -.01em;
  }

  .nav-mobile-link:hover { color: var(--violet-400); }
  .nav-mobile-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 4px; }

  .nav-mobile-footer { padding-top: 2rem; }

  /* Skip link */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 1rem;
    background: var(--violet-600);
    color: #fff;
    padding: .5rem 1rem;
    z-index: 9999;
    font-family: var(--font);
    font-size: 14px;
  }
  .skip-link:focus { left: 1rem; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .nav-desktop { gap: 1.25rem; }
  }

  @media (max-width: 768px) {
    .nav-desktop { display: none; }
    .hamburger { display: flex; }
    .header-actions .btn { display: none; }
    .lang-switcher { display: none; }
    .pre-header-contact { display: none; }
  }
</style>

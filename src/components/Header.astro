---
interface Props {
  lang?: string
}

const { lang = 'cs' } = Astro.props

const navCs = [
  { label: 'Domů', href: '/' },
  { label: 'O nás', href: '/o-nas' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Novinky', href: '/novinky' },
  { label: 'Kontakt', href: '/kontakt' },
]

const navEn = [
  { label: 'Home', href: '/en/' },
  { label: 'About', href: '/en/about' },
  { label: 'Portfolio', href: '/en/portfolio' },
  { label: 'News', href: '/en/news' },
  { label: 'Contact', href: '/en/contact' },
]

const nav = lang === 'en' ? navEn : navCs
const otherLangHref = lang === 'en' ? '/' : '/en/'
const currentLang = lang === 'en' ? 'EN' : 'CS'
const otherLang = lang === 'en' ? 'CS' : 'EN'
const contactHref = lang === 'en' ? '/en/contact' : '/kontakt'
const contactLabel = lang === 'en' ? 'Contact us' : 'Napište nám'
---

<header class="site-header" id="site-header" role="banner">
  <div class="header-capsule">
    <div class="header-inner">
      <!-- Logo -->
      <a href={lang === 'en' ? '/en/' : '/'} class="logo-link" aria-label="Globaal Elevate Production — Domů">
        <img src="/logo.png" class="logo-img" alt="Globaal Elevate Production" width="120" height="28" />
      </a>

      <!-- Desktop navigation -->
      <nav class="nav-desktop" aria-label={lang === 'en' ? 'Main navigation' : 'Hlavní navigace'}>
        {nav.map(item => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="header-actions">
        <!-- Language switcher -->
        <div class="lang-switch" role="group" aria-label={lang === 'en' ? 'Language' : 'Jazyk'}>
          <span class="lang-current" aria-current="true">{currentLang}</span>
          <span class="lang-divider" aria-hidden="true">/</span>
          <a href={otherLangHref} class="lang-other" aria-label={lang === 'en' ? 'Přepnout na češtinu' : 'Switch to English'}>
            {otherLang}
          </a>
        </div>

        <!-- Client portal ghost link -->
        <a
          href="https://klient.globaalelevate.com"
          class="client-portal"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'en' ? 'Client portal (opens in new tab)' : 'Klientský portál (otevře novou kartu)'}
        >
          {lang === 'en' ? 'Client portal' : 'Klientský portál'}
        </a>

        <!-- Primary CTA -->
        <a href={contactHref} class="btn btn-primary header-cta">
          {contactLabel}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>

        <!-- Hamburger -->
        <button class="hamburger" id="hamburger" aria-label={lang === 'en' ? 'Open menu' : 'Otevřít menu'} aria-expanded="false" aria-controls="nav-mobile">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile fullscreen menu -->
  <div class="nav-mobile" id="nav-mobile" role="dialog" aria-modal="true" aria-label={lang === 'en' ? 'Navigation menu' : 'Navigační menu'} hidden>
    <button class="nav-mobile-close" id="nav-mobile-close" aria-label={lang === 'en' ? 'Close menu' : 'Zavřít menu'}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <nav aria-label={lang === 'en' ? 'Mobile navigation' : 'Mobilní navigace'}>
      {nav.map(item => (
        <a href={item.href} class="nav-mobile-link">{item.label}</a>
      ))}
    </nav>

    <div class="nav-mobile-footer">
      <a href={contactHref} class="btn btn-primary nav-mobile-cta">
        {contactLabel} <span aria-hidden="true">→</span>
      </a>
      <a href={otherLangHref} class="nav-mobile-lang">
        {otherLang}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!
  const hamburger = document.getElementById('hamburger')!
  const navMobile = document.getElementById('nav-mobile')!
  const closeBtn = document.getElementById('nav-mobile-close')!

  // Focus trap helpers
  const focusable = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
  let prevFocus: HTMLElement | null = null

  function openMenu() {
    navMobile.hidden = false
    hamburger.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    prevFocus = document.activeElement as HTMLElement
    // Move focus to close button
    closeBtn.focus()
    // Trap focus
    navMobile.addEventListener('keydown', trapFocus)
    document.addEventListener('keydown', handleEsc)
  }

  function closeMenu() {
    navMobile.hidden = true
    hamburger.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    navMobile.removeEventListener('keydown', trapFocus)
    document.removeEventListener('keydown', handleEsc)
    prevFocus?.focus()
  }

  function trapFocus(e: KeyboardEvent) {
    const els = Array.from(navMobile.querySelectorAll<HTMLElement>(focusable))
    const first = els[0]
    const last = els[els.length - 1]
    if (e.key === 'Tab') {
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault()
        last.focus()
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault()
        first.focus()
      }
    }
  }

  function handleEsc(e: KeyboardEvent) {
    if (e.key === 'Escape') closeMenu()
  }

  hamburger.addEventListener('click', openMenu)
  closeBtn.addEventListener('click', closeMenu)

  // Close on mobile link click
  navMobile.querySelectorAll('.nav-mobile-link, .nav-mobile-cta').forEach(el => {
    el.addEventListener('click', closeMenu)
  })

  // Scroll-aware header opacity boost
  const onScroll = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 60)
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()
</script>

<style>
  /* ── Floating header container ── */
  .site-header {
    position: sticky;
    top: 16px;
    z-index: 200;
    padding: 0 var(--container-px);
    pointer-events: none; /* Let clicks pass through the gap */
  }

  .header-capsule {
    max-width: var(--container-width);
    margin: 0 auto;
    background: rgba(11, 16, 32, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 0 20px;
    pointer-events: all;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .is-scrolled .header-capsule {
    background: rgba(11, 16, 32, 0.92);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 1rem;
  }

  /* ── Logo ── */
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 28px;
    width: auto;
    filter: brightness(0) invert(1);
    transition: opacity 0.2s ease;
  }

  .logo-link:hover .logo-img { opacity: 0.8; }

  /* ── Desktop nav ── */
  .nav-desktop {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    padding: 6px 14px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-on-dark);
    border-radius: 10px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-on-dark);
    background: var(--navy-700);
  }

  /* Active link — determined server-side ideally, or JS */
  .nav-link[aria-current="page"] {
    color: var(--gold-400);
    background: var(--navy-700);
  }

  /* ── Actions ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  /* Language switcher */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .lang-current {
    color: var(--gold-400);
  }

  .lang-divider {
    color: var(--muted-on-dark);
    opacity: 0.5;
  }

  .lang-other {
    color: var(--muted-on-dark);
    transition: color 0.2s ease;
  }

  .lang-other:hover { color: var(--text-on-dark); }

  /* Client portal ghost */
  .client-portal {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-on-dark);
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  .client-portal:hover {
    color: var(--text-on-dark);
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Primary CTA */
  .header-cta {
    height: 38px;
    padding: 0 16px;
    font-size: 0.875rem;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
    padding: 0 9px;
    transition: border-color 0.2s ease;
    flex-shrink: 0;
  }

  .hamburger:hover { border-color: rgba(255,255,255,.25); }
  .hamburger:focus-visible { outline: 3px solid rgba(181,151,106,.45); outline-offset: 2px; }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--text-on-dark);
    border-radius: 2px;
    transition: all 0.25s ease;
    transform-origin: center;
  }

  /* ── Mobile full-screen menu ── */
  .nav-mobile {
    position: fixed;
    inset: 0;
    background: var(--navy-900);
    z-index: 300;
    display: flex;
    flex-direction: column;
    padding: 2rem var(--container-px-mobile);
  }

  .nav-mobile[hidden] { display: none; }

  .nav-mobile-close {
    align-self: flex-end;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy-800);
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text-on-dark);
    cursor: pointer;
    margin-bottom: 2rem;
    transition: border-color 0.2s ease;
  }

  .nav-mobile-close:hover { border-color: rgba(255,255,255,.25); }
  .nav-mobile-close:focus-visible { outline: 3px solid rgba(181,151,106,.45); }

  .nav-mobile nav {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .nav-mobile-link {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--muted-on-dark);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease;
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
  }

  .nav-mobile-link:first-child { border-top: 1px solid var(--line); }
  .nav-mobile-link:hover { color: var(--text-on-dark); }

  .nav-mobile-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 2rem;
  }

  .nav-mobile-cta {
    height: 52px;
    padding: 0 24px;
  }

  .nav-mobile-lang {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted-on-dark);
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .nav-mobile-lang:hover { color: var(--text-on-dark); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .nav-desktop { display: none; }
    .client-portal { display: none; }
    .hamburger { display: flex; }
    .header-cta { display: none; }
  }

  @media (max-width: 480px) {
    .site-header { padding: 0 12px; }
    .lang-switch { display: none; }
  }
</style>

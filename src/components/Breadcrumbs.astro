---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-content px-4 pt-6 text-sm sm:px-6">
  <ol class="flex flex-wrap items-center gap-1 text-muted">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span class="text-ink" aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href} class="transition hover:text-accent">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

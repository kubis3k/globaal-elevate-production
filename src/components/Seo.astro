---
interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  locale: 'cs' | 'en';
  alternates?: AlternateLink[];
  noindex?: boolean;
}

const { title, description, canonical, ogImage, locale, alternates = [], noindex = false } = Astro.props;

const ogLocale = locale === 'cs' ? 'cs_CZ' : 'en_US';
const resolvedOgImage = ogImage ?? '/og-default.png';
const absoluteOgImage = resolvedOgImage.startsWith('http')
  ? resolvedOgImage
  : new URL(resolvedOgImage, Astro.site).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content="Globaal Elevate" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

---
interface Step {
  n: number;
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step) => (
    <li class="flex flex-col gap-2">
      <span class="text-sm font-semibold text-accent">
        {String(step.n).padStart(2, '0')}
      </span>
      <h3 class="text-lg font-semibold text-ink">{step.title}</h3>
      <p class="text-sm text-muted">{step.body}</p>
    </li>
  ))}
</ol>

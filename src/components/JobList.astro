---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Job {
  title: string;
  employmentType: 'FULL_TIME' | 'PART_TIME' | 'CONTRACTOR' | 'INTERN';
  location: string;
  remote: boolean;
  salaryMin?: number;
  salaryMax?: number;
  salaryCurrency: string;
  salaryUnit: 'MONTH' | 'HOUR';
  applyEmail: string;
}

interface Props {
  jobs: Job[];
  locale: Locale;
}

const { jobs, locale } = Astro.props;
const t = useTranslations(locale);

function formatSalary(job: Job): string | null {
  if (job.salaryMin == null && job.salaryMax == null) return null;
  const formatter = new Intl.NumberFormat(locale === 'cs' ? 'cs-CZ' : 'en-US');
  const unit = t(`jobs.salaryUnit.${job.salaryUnit}`);
  const range =
    job.salaryMin != null && job.salaryMax != null
      ? `${formatter.format(job.salaryMin)}–${formatter.format(job.salaryMax)}`
      : formatter.format((job.salaryMin ?? job.salaryMax) as number);
  return `${range} ${job.salaryCurrency}/${unit}`;
}
---

{jobs.length === 0 ? (
  <p class="rounded-lg border border-line p-6 text-center text-muted">
    {t('jobs.empty')}
  </p>
) : (
  <ul class="flex flex-col gap-4">
    {jobs.map((job) => {
      const salary = formatSalary(job);
      return (
        <li class="flex flex-col gap-3 rounded-lg border border-line p-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-col gap-1.5">
            <h3 class="text-lg font-semibold text-ink">{job.title}</h3>
            <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
              <span>{t(`jobs.employmentType.${job.employmentType}`)}</span>
              <span aria-hidden="true">&middot;</span>
              <span>{job.location}</span>
              {job.remote && (
                <span class="inline-flex items-center rounded-full border border-line px-2 py-0.5 text-xs font-medium text-accent">
                  {t('jobs.remote')}
                </span>
              )}
            </div>
            {salary && <p class="text-sm text-muted">{salary}</p>}
          </div>
          <a
            href={`mailto:${job.applyEmail}`}
            class="inline-flex flex-none items-center justify-center rounded-md border border-line px-4 py-2 text-sm font-medium text-ink transition hover:border-accent hover:text-accent"
          >
            {t('jobs.apply')} {job.applyEmail}
          </a>
        </li>
      );
    })}
  </ul>
)}

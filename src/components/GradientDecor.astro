---
interface Props {
  top?: string
  left?: string
  right?: string
  size?: string
  opacity?: string
}

const {
  top = '10%',
  left,
  right,
  size = '600px',
  opacity = '0.15'
} = Astro.props
---

<div
  class="gradient-orb"
  style={`
    width: ${size};
    height: ${size};
    top: ${top};
    ${left ? `left: ${left};` : ''}
    ${right ? `right: ${right};` : ''}
    opacity: ${opacity};
  `}
  aria-hidden="true"
></div>

<style>
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle at center, #B8935A 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }
</style>

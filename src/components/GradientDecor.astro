---
// Subtle decorative radial gradient in the brand accent color. Purely
// visual, no interactivity — kept very low-opacity by design.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={`pointer-events-none absolute inset-0 -z-10 overflow-hidden ${className}`}
  aria-hidden="true"
>
  <div
    class="absolute left-1/2 top-0 h-[36rem] w-[36rem] -translate-x-1/2 -translate-y-1/3 rounded-full"
    style="background: radial-gradient(circle, rgba(118,6,255,0.08) 0%, rgba(118,6,255,0) 70%);"
  >
  </div>
</div>

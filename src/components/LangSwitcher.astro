---
import type { Locale } from '../i18n/ui';
import { localizePath, unlocalizePath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);

const targetLocale: Locale = locale === 'cs' ? 'en' : 'cs';
const barePath = unlocalizePath(path);
// Not every cs page has a guaranteed EN equivalent yet; content pages that
// don't exist for the target locale fall back to that locale's home page
// via the i18n `fallback` config, or the page's own 404 handling.
const targetPath = localizePath(barePath, targetLocale);
---

<a
  href={targetPath}
  class="text-sm font-medium text-ink/70 transition hover:text-accent"
  hreflang={targetLocale}
  lang={targetLocale}
>
  {t('lang.switchTo')}
</a>

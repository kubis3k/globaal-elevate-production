---
// Minimalist prose wrapper for long-form markdown body content.
// No @tailwindcss/typography plugin is installed in this project, so the
// typographic rules are written as plain CSS scoped to this component.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 42rem;
    color: var(--color-ink);
    font-size: 1rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    margin-top: 2em;
    margin-bottom: 0.75em;
    font-size: 1.375rem;
    font-weight: 700;
  }

  .prose :global(h3) {
    margin-top: 1.75em;
    margin-bottom: 0.5em;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
    padding-left: 1.25em;
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(li) {
    margin-top: 0.375em;
    margin-bottom: 0.375em;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 2px solid var(--color-line);
    color: var(--color-muted);
  }

  .prose :global(hr) {
    margin: 2em 0;
    border: none;
    border-top: 1px solid var(--color-line);
  }
</style>

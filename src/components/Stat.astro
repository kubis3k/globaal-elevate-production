---
interface Props {
  value: string
  label: string
  onLight?: boolean
}
const { value, label, onLight = false } = Astro.props
---

<div class={`stat-item ${onLight ? 'on-light' : ''}`}>
  <span class="stat-value">{value}</span>
  <span class="stat-label">{label}</span>
</div>

<style>
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }

  .stat-value {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--text-dark);
  }

  .stat-label {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted-dark);
  }

  .on-light .stat-value { color: var(--text-light); }
  .on-light .stat-label { color: var(--muted-light); }
</style>

---
import GradientDecor from './GradientDecor.astro'

interface Props {
  badge?: string
  heading: string
  accentPhrase?: string
  lead: string
  ctaPrimary?: string
  ctaSecondary?: string
  ctaPrimaryHref?: string
  ctaSecondaryHref?: string
  bgPhoto?: string
}

const {
  badge,
  heading,
  accentPhrase,
  lead,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryHref = '/',
  ctaSecondaryHref = '/',
  bgPhoto,
} = Astro.props

let headingBefore = heading
let headingAfter = ''

if (accentPhrase && heading.includes(accentPhrase)) {
  const idx = heading.indexOf(accentPhrase)
  headingBefore = heading.slice(0, idx)
  headingAfter = heading.slice(idx + accentPhrase.length)
}
---

<section class="hero">
  <!-- Background: real photo if provided, else logo blur -->
  {bgPhoto ? (
    <img src={bgPhoto} class="hero-bg-photo" alt="" aria-hidden="true" loading="eager" />
  ) : (
    <img src="/logo.png" class="hero-logo-bg" alt="" aria-hidden="true" />
  )}

  <div class="container hero-content">
    {badge && (
      <span class="section-label hero-anim" style="animation-delay:0.1s">{badge}</span>
    )}

    <h1 class="hero-heading hero-anim" style="animation-delay:0.25s">
      {accentPhrase ? (
        <>
          {headingBefore}<em class="h-accent">{accentPhrase}</em>{headingAfter}
        </>
      ) : heading}
    </h1>

    <p class="hero-lead hero-anim" style="animation-delay:0.4s">{lead}</p>

    {(ctaPrimary || ctaSecondary) && (
      <div class="hero-ctas hero-anim" style="animation-delay:0.55s">
        {ctaPrimary && (
          <a href={ctaPrimaryHref} class="btn btn-filled">{ctaPrimary}</a>
        )}
        {ctaSecondary && (
          <a href={ctaSecondaryHref} class="btn btn-outline hero-btn-outline">{ctaSecondary}</a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    padding: 10rem 0 6rem;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  /* Decorative logo blur (default, when no real photo) */
  .hero-logo-bg {
    position: absolute;
    width: 90%;
    max-width: 1100px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(80px) invert(1);
    mix-blend-mode: screen;
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }

  :global([data-theme="light"]) .hero-logo-bg {
    filter: blur(80px);
    mix-blend-mode: multiply;
    opacity: 0.04;
  }

  /* Real hero background photo */
  .hero-bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.18;
    pointer-events: none;
    user-select: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  /* Section label in hero — keep neutral (muted), same as global .section-label */
  .hero .section-label {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-heading {
    font-size: clamp(2.75rem, 8vw, 6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--fg);
  }

  /* Accent phrase: Playfair Display italic — distinguishes from sans-serif heading */
  .h-accent {
    color: var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: 0.95em;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--fg-muted);
    max-width: 580px;
    margin-top: 1.5rem;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-btn-outline {
    color: var(--fg);
    border-color: var(--border);
  }

  .hero-btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  .hero-anim {
    opacity: 0;
    animation: heroFadeUp 0.7s ease forwards;
  }
</style>

---
interface Props {
  badge?: string
  heading: string
  accentPhrase?: string
  lead: string
  ctaPrimary?: string
  ctaSecondary?: string
  ctaPrimaryHref?: string
  ctaSecondaryHref?: string
  bgPhoto?: string
}

const {
  badge,
  heading,
  accentPhrase,
  lead,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryHref = '/',
  ctaSecondaryHref = '/',
} = Astro.props

let headingBefore = heading
let headingAfter = ''

if (accentPhrase && heading.includes(accentPhrase)) {
  const idx = heading.indexOf(accentPhrase)
  headingBefore = heading.slice(0, idx)
  headingAfter = heading.slice(idx + accentPhrase.length)
}
---

<section class="hero">
  <div class="container hero-inner">
    <!-- Left: text -->
    <div class="hero-text">
      {badge && (
        <span class="section-label hero-anim" style="animation-delay:0.1s">{badge}</span>
      )}

      <h1 class="hero-heading hero-anim" style="animation-delay:0.25s">
        {accentPhrase ? (
          <>
            {headingBefore}<em class="h-accent">{accentPhrase}</em>{headingAfter}
          </>
        ) : heading}
      </h1>

      <p class="hero-lead hero-anim" style="animation-delay:0.4s">{lead}</p>

      {(ctaPrimary || ctaSecondary) && (
        <div class="hero-ctas hero-anim" style="animation-delay:0.55s">
          {ctaPrimary && (
            <a href={ctaPrimaryHref} class="btn btn-filled">{ctaPrimary}</a>
          )}
          {ctaSecondary && (
            <a href={ctaSecondaryHref} class="btn btn-outline hero-btn-outline">{ctaSecondary}</a>
          )}
        </div>
      )}
    </div>

    <!-- Right: abstract geometric visual -->
    <div class="hero-visual hero-anim" style="animation-delay:0.3s" aria-hidden="true">
      <svg class="geo-svg" viewBox="0 0 520 520" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Gradient definitions -->
        <defs>
          <radialGradient id="glow1" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#B8935A" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#B8935A" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="glow2" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#D4A96A" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="#B8935A" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#B8935A" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#B8935A" stop-opacity="0.05"/>
          </linearGradient>
          <filter id="blur1">
            <feGaussianBlur stdDeviation="30"/>
          </filter>
        </defs>

        <!-- Soft gradient blobs -->
        <ellipse cx="280" cy="240" rx="220" ry="220" fill="url(#glow1)" filter="url(#blur1)"/>
        <ellipse cx="340" cy="300" rx="140" ry="140" fill="url(#glow2)" filter="url(#blur1)"/>

        <!-- Large circle outline -->
        <circle cx="260" cy="260" r="220" stroke="#B8935A" stroke-opacity="0.15" stroke-width="1"/>
        <circle cx="260" cy="260" r="170" stroke="#B8935A" stroke-opacity="0.1" stroke-width="1"/>
        <circle cx="260" cy="260" r="120" stroke="#B8935A" stroke-opacity="0.08" stroke-width="1"/>

        <!-- Diamond / rotated square (corporate geometric) -->
        <rect x="160" y="160" width="200" height="200" rx="2"
          stroke="url(#lineGrad)" stroke-width="1.5"
          transform="rotate(45 260 260)"/>

        <!-- Smaller inner diamond -->
        <rect x="200" y="200" width="120" height="120" rx="1"
          stroke="#B8935A" stroke-opacity="0.25" stroke-width="1"
          transform="rotate(45 260 260)"/>

        <!-- Horizontal rule lines -->
        <line x1="40" y1="130" x2="480" y2="130" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
        <line x1="40" y1="260" x2="480" y2="260" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
        <line x1="40" y1="390" x2="480" y2="390" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>

        <!-- Vertical rule lines -->
        <line x1="130" y1="40" x2="130" y2="480" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
        <line x1="260" y1="40" x2="260" y2="480" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
        <line x1="390" y1="40" x2="390" y2="480" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>

        <!-- Dot grid (3×3 key intersections) -->
        <circle cx="130" cy="130" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="260" cy="130" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="390" cy="130" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="130" cy="260" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="260" cy="260" r="4"   fill="#B8935A" fill-opacity="0.5"/>
        <circle cx="390" cy="260" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="130" cy="390" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="260" cy="390" r="2.5" fill="#B8935A" fill-opacity="0.3"/>
        <circle cx="390" cy="390" r="2.5" fill="#B8935A" fill-opacity="0.3"/>

        <!-- Corner accent bracket (top-left) -->
        <path d="M 80 80 L 80 140 M 80 80 L 140 80" stroke="#B8935A" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Corner accent bracket (bottom-right) -->
        <path d="M 440 440 L 440 380 M 440 440 L 380 440" stroke="#B8935A" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    position: relative;
    z-index: 1;
  }

  .hero .section-label {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-heading {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--fg);
  }

  .h-accent {
    color: var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1em;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--fg-muted);
    max-width: 520px;
    margin-top: 1.75rem;
    line-height: 1.75;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-btn-outline {
    color: var(--fg);
    border-color: var(--border);
  }

  .hero-btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Abstract geometric visual */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .geo-svg {
    width: 100%;
    max-width: 480px;
    height: auto;
    display: block;
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  .hero-anim {
    opacity: 0;
    animation: heroFadeUp 0.7s ease forwards;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero {
      min-height: auto;
      padding: 8rem 0 4rem;
    }

    .hero-visual {
      max-width: 340px;
      margin: 0 auto;
    }

    .hero-heading {
      font-size: clamp(2.25rem, 8vw, 3.5rem);
    }
  }

  @media (max-width: 640px) {
    .hero-visual {
      display: none;
    }
  }
</style>

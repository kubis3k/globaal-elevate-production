---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<div class="newsletter-wrap anim-fade">
  <div class="newsletter-inner">
    <div class="newsletter-copy">
      <p class="nl-label">{isEn ? '• Newsletter' : '• Newsletter'}</p>
      <h2 class="nl-heading">
        {isEn ? 'Stay in the loop.' : 'Zůstaňte v obraze.'}
      </h2>
      <p class="nl-lead">
        {isEn
          ? 'Projects, events, music and what\'s happening behind the scenes — straight to your inbox.'
          : 'Projekty, eventy, hudba a co se děje za kulisami — přímo do vaší schránky.'}
      </p>
    </div>

    <!-- Form state -->
    <div class="nl-form-area" id="nl-inline-form-area">
      <form class="nl-form" id="nl-form" novalidate>
        <!-- Honeypot -->
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;"
        />
        <div class="nl-field-row">
          <div class="nl-field">
            <label class="sr-only" for="nl-email">
              {isEn ? 'Your email' : 'Váš e-mail'}
            </label>
            <input
              type="email"
              id="nl-email"
              name="email"
              placeholder={isEn ? 'your@email.com' : 'vas@email.cz'}
              required
              autocomplete="email"
              aria-describedby="nl-inline-err"
            />
          </div>
          <button type="submit" class="nl-btn" id="nl-btn">
            <span class="nl-btn-text">{isEn ? 'Subscribe →' : 'Přihlásit se →'}</span>
            <span class="nl-btn-spinner" hidden aria-hidden="true">
              <svg class="nl-spinner-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
            </span>
          </button>
        </div>
        <p class="nl-err" id="nl-inline-err" aria-live="polite"></p>
      </form>
      <p class="nl-fine">
        {isEn ? 'No spam. Unsubscribe anytime.' : 'Žádný spam. Odhlášení kdykoliv.'}
        {' '}
        <a href={isEn ? '/en/gdpr' : '/gdpr'} class="nl-privacy-link">
          {isEn ? 'Privacy policy' : 'Zásady ochrany'}
        </a>
      </p>
    </div>

    <!-- Success state — replaces form area -->
    <div class="nl-success-area" id="nl-inline-success" hidden aria-live="polite">
      <div class="nl-success-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </div>
      <p class="nl-success-title">
        {isEn ? 'Almost done!' : 'Skoro hotovo!'}
      </p>
      <p class="nl-success-text">
        {isEn
          ? 'We sent you a confirmation email. Click the link inside to complete your signup.'
          : 'Poslali jsme vám e-mail. Klikněte na odkaz v něm a přihlášení potvrďte.'}
      </p>
      <p class="nl-success-hint">
        {isEn
          ? 'Nothing arrived? Check spam or Promotions.'
          : 'Nic nepřišlo? Mrkněte do spamu nebo složky Hromadné.'}
      </p>
    </div>
  </div>
</div>

<style>
  .newsletter-wrap {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3rem;
  }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .nl-label {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .nl-heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--fg);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }

  .nl-lead {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* Form area */
  .nl-form-area {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nl-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nl-field-row {
    display: flex;
    gap: 0.625rem;
  }

  .nl-field {
    flex: 1;
  }

  .nl-field input {
    width: 100%;
    height: 48px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0 1rem;
    font-size: 0.9375rem;
    color: var(--fg);
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
    box-sizing: border-box;
  }

  .nl-field input::placeholder { color: var(--fg-muted); }

  .nl-field input:focus {
    border-color: #B5976A;
    box-shadow: 0 0 0 3px rgba(181, 151, 106, 0.2);
  }

  .nl-field input.nl-invalid { border-color: #D64545; }

  .nl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 48px;
    padding: 0 1.5rem;
    background: #B5976A;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .nl-btn:hover:not(:disabled) { background: #A3845A; }
  .nl-btn:disabled { opacity: 0.65; cursor: not-allowed; }

  .nl-spinner-svg { animation: inlineSpin 0.8s linear infinite; }

  @keyframes inlineSpin { to { transform: rotate(360deg); } }

  .nl-err {
    font-size: 0.8125rem;
    color: #D64545;
    margin: 0;
    min-height: 1em;
  }

  .nl-fine {
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.5;
  }

  .nl-privacy-link {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .nl-privacy-link:hover { color: var(--fg); }

  /* Screen-reader-only label */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* Success area */
  .nl-success-area {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nl-success-area[hidden] { display: none; }

  .nl-success-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: #FDF8F2;
    border: 1px solid rgba(181, 151, 106, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B5976A;
    margin-bottom: 4px;
  }

  .nl-success-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--fg);
    margin: 0;
  }

  .nl-success-text {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.65;
    margin: 0;
  }

  .nl-success-hint {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin: 0;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .newsletter-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .newsletter-wrap {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .nl-field-row {
      flex-direction: column;
    }
    .nl-btn {
      width: 100%;
    }
  }
</style>

<script define:vars={{ lang }}>
  const form      = document.getElementById('nl-form')
  const emailInput = form.querySelector('#nl-email')
  const btn       = document.getElementById('nl-btn')
  const btnText   = btn.querySelector('.nl-btn-text')
  const btnSpinner = btn.querySelector('.nl-btn-spinner')
  const errEl     = document.getElementById('nl-inline-err')
  const formArea  = document.getElementById('nl-inline-form-area')
  const successArea = document.getElementById('nl-inline-success')
  const honeypot  = form.querySelector('input[name="website"]')

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()

    // Client-side validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    if (!email || !emailRegex.test(email)) {
      emailInput.classList.add('nl-invalid')
      errEl.textContent = lang === 'en'
        ? 'Please enter a valid email address.'
        : 'Zadejte platný e-mail.'
      emailInput.focus()
      return
    }

    emailInput.classList.remove('nl-invalid')
    errEl.textContent = ''
    btn.disabled = true
    btnText.hidden = true
    btnSpinner.hidden = false

    try {
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          website: honeypot?.value ?? '',
          source: 'inline',
          lang,
        }),
      })

      if (res.ok || res.status === 200) {
        // Show success — mark popup as subscribed so it won't appear
        try {
          localStorage.setItem('gep_nl_popup', JSON.stringify({ status: 'subscribed', ts: Date.now() }))
        } catch {}
        formArea.hidden = true
        successArea.hidden = false
      } else {
        const data = await res.json().catch(() => ({}))
        if (data.error === 'Invalid email') {
          errEl.textContent = lang === 'en'
            ? 'Please enter a valid email address.'
            : 'Zadejte platný e-mail.'
        } else if (res.status === 429) {
          errEl.textContent = lang === 'en'
            ? 'Too many attempts. Try again in a few minutes.'
            : 'Příliš mnoho pokusů. Zkuste to za chvíli.'
        } else {
          throw new Error()
        }
        btn.disabled = false
        btnText.hidden = false
        btnSpinner.hidden = true
      }
    } catch {
      errEl.textContent = lang === 'en'
        ? 'Something went wrong. Please try again.'
        : 'Něco se nepovedlo. Zkuste to znovu.'
      btn.disabled = false
      btnText.hidden = false
      btnSpinner.hidden = true
    }
  })

  emailInput.addEventListener('input', () => {
    emailInput.classList.remove('nl-invalid')
    errEl.textContent = ''
  })
</script>

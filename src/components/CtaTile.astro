---
interface Props {
  label: string;
  href: string;
  note?: string;
  external?: boolean;
}

const { label, href, note, external = false } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col justify-between gap-3 rounded-lg border border-line p-6 transition hover:border-accent hover:shadow-sm"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <div class="flex items-start justify-between gap-2">
    <span class="text-lg font-semibold text-ink transition group-hover:text-accent">
      {label}
    </span>
    {external && (
      <svg
        class="mt-1 h-4 w-4 flex-none text-muted transition group-hover:text-accent"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M6 3h7v7" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M13 3 3 13" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
  </div>
  {note && <p class="text-sm text-muted">{note}</p>}
</a>

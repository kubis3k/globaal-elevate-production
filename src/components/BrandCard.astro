---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  name: string;
  pillar: 'events' | 'music' | 'ticketing' | 'saas' | 'marketing';
  summary: string;
  url?: string;
  external?: boolean;
  status?: 'live' | 'building';
  locale: Locale;
}

const { name, pillar, summary, url, external = false, status = 'live', locale } = Astro.props;
const t = useTranslations(locale);
---

<article class="flex flex-col gap-3 rounded-lg border border-line p-6">
  <div class="flex items-center justify-between gap-2">
    <span class="inline-flex items-center rounded-full border border-line px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide text-muted">
      {pillar}
    </span>
    {status === 'building' && (
      <span class="text-xs font-medium text-accent">{t('brand.building')}</span>
    )}
  </div>

  <h3 class="text-lg font-semibold text-ink">{name}</h3>
  <p class="text-sm text-muted">{summary}</p>

  {url && (
    <a
      href={url}
      class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline"
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {t('brand.visit')}
      {external && (
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M6 3h7v7" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M13 3 3 13" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
    </a>
  )}
</article>

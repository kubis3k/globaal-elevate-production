---
interface Props {
  src?: string
  alt: string
  ratio?: string
  label?: string
  class?: string
}

const { src, alt, ratio = '16/9', label = 'Fotografie', class: className = '' } = Astro.props
---

<div class={`img-slot ${className}`} style={`aspect-ratio: ${ratio}`}>
  <!-- Placeholder always in DOM; real photo covers it when it loads -->
  <div class="img-slot-ph" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
    <span>{label}</span>
  </div>
  {src && (
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="img-slot-real"
      onerror="this.style.display='none'"
    />
  )}
</div>

<style>
  /* Global .img-slot styles are in global.css */
  .img-slot-real {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
</style>

---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<div id="nl-popup" class="nl-popup" role="dialog" aria-modal="true" aria-label={isEn ? 'Newsletter signup' : 'Přihlášení k newsletteru'} hidden>
  <div class="nl-backdrop" id="nl-backdrop"></div>

  <div class="nl-card">
    <!-- Close -->
    <button class="nl-close" id="nl-close" aria-label={isEn ? 'Close' : 'Zavřít'}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <!-- Decoration -->
    <div class="nl-deco" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="90" stroke="#B8935A" stroke-opacity="0.12" stroke-width="1"/>
        <circle cx="100" cy="100" r="60" stroke="#B8935A" stroke-opacity="0.08" stroke-width="1"/>
        <rect x="50" y="50" width="100" height="100" rx="1" stroke="#B8935A" stroke-opacity="0.1" stroke-width="1" transform="rotate(45 100 100)"/>
        <ellipse cx="110" cy="90" rx="70" ry="70" fill="#B8935A" fill-opacity="0.06" filter="url(#pop-blur)"/>
        <defs><filter id="pop-blur"><feGaussianBlur stdDeviation="20"/></filter></defs>
      </svg>
    </div>

    <!-- Content -->
    <div class="nl-content">
      <span class="nl-eyebrow">
        {isEn ? '• Newsletter' : '• Newsletter'}
      </span>

      <h2 class="nl-heading">
        {isEn ? 'Stay in the loop.' : 'Zůstaňte v obraze.'}
      </h2>

      <p class="nl-body">
        {isEn
          ? 'Projects, events and what\'s happening behind the scenes — straight to your inbox. No spam.'
          : 'Projekty, eventy a co se děje za kulisami — přímo do vaší schránky. Žádný spam.'}
      </p>

      <form class="nl-form" id="nl-pop-form" novalidate>
        <div class="nl-row">
          <input
            type="email"
            id="nl-pop-email"
            name="email"
            placeholder={isEn ? 'your@email.com' : 'vas@email.cz'}
            required
            autocomplete="email"
            class="nl-input"
          />
          <button type="submit" class="nl-submit" id="nl-pop-btn">
            <span class="nl-btn-text">{isEn ? 'Subscribe' : 'Přihlásit'}</span>
            <span class="nl-btn-check" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
          </button>
        </div>
        <p class="nl-err" id="nl-pop-err" aria-live="polite"></p>
      </form>

      <p class="nl-skip">
        <button type="button" id="nl-dismiss" class="nl-skip-btn">
          {isEn ? 'No thanks' : 'Teď ne'}
        </button>
      </p>
    </div>
  </div>
</div>

<style>
  /* Overlay */
  .nl-popup {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .nl-popup[hidden] {
    display: none !important;
  }

  .nl-popup.nl-entering .nl-card {
    animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .nl-popup.nl-leaving .nl-card {
    animation: popOut 0.22s ease forwards;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.88) translateY(16px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes popOut {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(0.94) translateY(8px); }
  }

  /* Backdrop */
  .nl-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    cursor: pointer;
  }

  /* Card */
  .nl-card {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 2.5rem;
    max-width: 440px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
  }

  /* Close button */
  .nl-close {
    position: absolute;
    top: 1.125rem;
    right: 1.125rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    z-index: 1;
    padding: 0;
    font-family: inherit;
  }

  .nl-close:hover {
    border-color: var(--fg);
    color: var(--fg);
    background: var(--bg-surface);
  }

  /* Geometric decoration */
  .nl-deco {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 180px;
    height: 180px;
    pointer-events: none;
    opacity: 0.7;
  }

  .nl-deco svg {
    width: 100%;
    height: 100%;
  }

  /* Content */
  .nl-content {
    position: relative;
    z-index: 1;
  }

  .nl-eyebrow {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.875rem;
  }

  .nl-heading {
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    font-weight: 800;
    color: var(--fg);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 0.875rem;
  }

  .nl-body {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    line-height: 1.7;
    margin: 0 0 1.75rem;
  }

  /* Form */
  .nl-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .nl-row {
    display: flex;
    gap: 0.5rem;
  }

  .nl-input {
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    color: var(--fg);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
    min-width: 0;
  }

  .nl-input::placeholder { color: var(--fg-muted); }
  .nl-input:focus { border-color: var(--accent); }

  .nl-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.75rem 1.25rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .nl-submit:hover:not(:disabled) {
    background: var(--accent-dark);
    transform: translateY(-1px);
  }

  .nl-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
  .nl-submit.sent { background: #22c55e; }

  .nl-err {
    font-size: 0.8125rem;
    color: #ef4444;
    margin: 0;
    min-height: 1em;
  }

  /* Skip */
  .nl-skip { margin: 0; text-align: center; }

  .nl-skip-btn {
    background: none;
    border: none;
    color: var(--fg-muted);
    font-size: 0.8125rem;
    cursor: pointer;
    font-family: inherit;
    padding: 0.25rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .nl-skip-btn:hover {
    color: var(--fg);
    text-decoration-color: var(--border);
  }

  @media (max-width: 480px) {
    .nl-card { padding: 2rem 1.5rem; }
    .nl-row { flex-direction: column; }
    .nl-submit { width: 100%; }
  }
</style>

<script define:vars={{ lang }}>
  const STORAGE_KEY = 'gep_nl_popup'
  const DELAY_MS = 9000       // show after 9s
  const SCROLL_THRESHOLD = 0.35 // or after scrolling 35% of page

  const popup  = document.getElementById('nl-popup')
  const backdrop = document.getElementById('nl-backdrop')
  const closeBtn = document.getElementById('nl-close')
  const dismissBtn = document.getElementById('nl-dismiss')
  const form   = document.getElementById('nl-pop-form')
  const input  = document.getElementById('nl-pop-email')
  const btn    = document.getElementById('nl-pop-btn')
  const btnText = btn.querySelector('.nl-btn-text')
  const btnCheck = btn.querySelector('.nl-btn-check')
  const errEl  = document.getElementById('nl-pop-err')

  function shouldShow() {
    try {
      const val = localStorage.getItem(STORAGE_KEY)
      if (!val) return true
      const { status, ts } = JSON.parse(val)
      if (status === 'subscribed') return false
      if (status === 'dismissed') {
        // Show again after 7 days
        return Date.now() - ts > 7 * 24 * 60 * 60 * 1000
      }
      return true
    } catch { return true }
  }

  function saveState(status) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status, ts: Date.now() })) } catch {}
  }

  function openPopup() {
    if (!shouldShow()) return
    popup.hidden = false
    popup.classList.add('nl-entering')
    setTimeout(() => popup.classList.remove('nl-entering'), 400)
    // Trap focus
    setTimeout(() => input.focus(), 350)
  }

  function closePopup(status = 'dismissed') {
    saveState(status)
    popup.classList.add('nl-leaving')
    setTimeout(() => {
      popup.hidden = true
      popup.classList.remove('nl-leaving')
    }, 240)
  }

  // Trigger: time OR scroll
  let triggered = false
  function trigger() {
    if (triggered || !shouldShow()) return
    triggered = true
    openPopup()
  }

  const timer = setTimeout(trigger, DELAY_MS)

  const onScroll = () => {
    const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight)
    if (scrolled >= SCROLL_THRESHOLD) {
      clearTimeout(timer)
      trigger()
      window.removeEventListener('scroll', onScroll)
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })

  // Close actions
  closeBtn.addEventListener('click', () => closePopup('dismissed'))
  dismissBtn.addEventListener('click', () => closePopup('dismissed'))
  backdrop.addEventListener('click', () => closePopup('dismissed'))

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup.hidden) closePopup('dismissed')
  })

  // Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = input.value.trim()
    if (!email) return

    btn.disabled = true
    btnText.textContent = lang === 'en' ? 'Subscribing…' : 'Přihlašuji…'
    errEl.textContent = ''

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, lang }),
      })

      if (res.ok) {
        btn.classList.add('sent')
        btnText.hidden = true
        btnCheck.hidden = false
        saveState('subscribed')
        // Close after short delay to show success
        setTimeout(() => closePopup('subscribed'), 1800)
      } else {
        const data = await res.json().catch(() => ({}))
        errEl.textContent = data.error === 'Invalid email'
          ? (lang === 'en' ? 'Please enter a valid email.' : 'Zadejte platný email.')
          : (lang === 'en' ? 'Something went wrong. Try again.' : 'Něco se nepovedlo. Zkuste znovu.')
        btn.disabled = false
        btnText.textContent = lang === 'en' ? 'Subscribe' : 'Přihlásit'
      }
    } catch {
      errEl.textContent = lang === 'en' ? 'Something went wrong.' : 'Něco se nepovedlo.'
      btn.disabled = false
      btnText.textContent = lang === 'en' ? 'Subscribe' : 'Přihlásit'
    }
  })
</script>

---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<div id="nl-popup" class="nl-popup" role="dialog" aria-modal="true" aria-label={isEn ? 'Newsletter signup' : 'Přihlášení k newsletteru'} hidden>
  <div class="nl-backdrop" id="nl-backdrop"></div>

  <div class="nl-card">
    <!-- Close -->
    <button class="nl-close" id="nl-close" aria-label={isEn ? 'Close' : 'Zavřít'}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <!-- Left panel: branding -->
    <div class="nl-left">
      <!-- Geometric background decoration -->
      <div class="nl-geo" aria-hidden="true">
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="pg1" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#B8935A" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#B8935A" stop-opacity="0"/>
            </radialGradient>
            <filter id="pgblur"><feGaussianBlur stdDeviation="28"/></filter>
          </defs>
          <ellipse cx="220" cy="180" rx="180" ry="180" fill="url(#pg1)" filter="url(#pgblur)"/>
          <circle cx="200" cy="200" r="180" stroke="#B8935A" stroke-opacity="0.12" stroke-width="1"/>
          <circle cx="200" cy="200" r="130" stroke="#B8935A" stroke-opacity="0.08" stroke-width="1"/>
          <circle cx="200" cy="200" r="80"  stroke="#B8935A" stroke-opacity="0.07" stroke-width="1"/>
          <rect x="90" y="90" width="220" height="220" rx="2" stroke="#B8935A" stroke-opacity="0.12" stroke-width="1.5" transform="rotate(45 200 200)"/>
          <rect x="130" y="130" width="140" height="140" rx="1" stroke="#B8935A" stroke-opacity="0.08" stroke-width="1" transform="rotate(45 200 200)"/>
          <line x1="0" y1="200" x2="400" y2="200" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
          <line x1="200" y1="0" x2="200" y2="400" stroke="#B8935A" stroke-opacity="0.06" stroke-width="1"/>
          <circle cx="200" cy="200" r="4" fill="#B8935A" fill-opacity="0.5"/>
          <path d="M 60 60 L 60 100 M 60 60 L 100 60" stroke="#B8935A" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M 340 340 L 340 300 M 340 340 L 300 340" stroke="#B8935A" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Logo -->
      <div class="nl-logo">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Globaal Elevate Production">
          <!-- G mark -->
          <rect x="0" y="4" width="32" height="32" rx="6" fill="#B8935A"/>
          <text x="16" y="26" font-family="'Inter',sans-serif" font-size="18" font-weight="800" fill="#ffffff" text-anchor="middle" dominant-baseline="auto">G</text>
          <!-- Wordmark -->
          <text x="40" y="15" font-family="'Inter',sans-serif" font-size="10" font-weight="800" fill="#ffffff" letter-spacing="0.08em">GLOBAAL ELEVATE</text>
          <text x="40" y="29" font-family="'Inter',sans-serif" font-size="7.5" font-weight="500" fill="#B8935A" letter-spacing="0.2em">PRODUCTION</text>
        </svg>
      </div>

      <!-- Copy -->
      <p class="nl-eyebrow">{isEn ? '• Newsletter' : '• Newsletter'}</p>
      <h2 class="nl-heading">
        {isEn ? 'Stay in\nthe loop.' : 'Zůstaňte\nv obraze.'}
      </h2>
      <ul class="nl-bullets" aria-hidden="true">
        <li>{isEn ? 'Projects & events' : 'Projekty a eventy'}</li>
        <li>{isEn ? 'Music releases' : 'Nová hudba'}</li>
        <li>{isEn ? 'Behind the scenes' : 'Za kulisami'}</li>
      </ul>
    </div>

    <!-- Right panel: form -->
    <div class="nl-right">
      <p class="nl-tagline">
        {isEn
          ? 'Join the people who get first access to everything we build.'
          : 'Přidejte se k těm, kdo se dozví první, co chystáme.'}
      </p>

      <form class="nl-form" id="nl-pop-form" novalidate>
        <label class="nl-label" for="nl-pop-email">
          {isEn ? 'Your email' : 'Váš email'}
        </label>
        <input
          type="email"
          id="nl-pop-email"
          name="email"
          placeholder={isEn ? 'you@example.com' : 'vy@priklad.cz'}
          required
          autocomplete="email"
          class="nl-input"
        />
        <button type="submit" class="nl-submit" id="nl-pop-btn">
          <span class="nl-btn-text">{isEn ? 'Subscribe' : 'Přihlásit se'}</span>
          <span class="nl-btn-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
          <span class="nl-btn-check" hidden aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
        </button>
        <p class="nl-err" id="nl-pop-err" aria-live="polite"></p>
      </form>

      <div class="nl-footer">
        <p class="nl-fine">
          {isEn ? 'No spam. Unsubscribe anytime.' : 'Bez spamu. Odhlášení kdykoliv.'}
          {' '}
          <a href={isEn ? '/en/gdpr' : '/gdpr'} class="nl-gdpr-link" tabindex="-1">
            {isEn ? 'Privacy policy' : 'Zásady ochrany údajů'}
          </a>
        </p>
        <button type="button" id="nl-dismiss" class="nl-skip-btn">
          {isEn ? 'Maybe later' : 'Teď ne'}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .nl-popup {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .nl-popup[hidden] { display: none !important; }

  .nl-popup.nl-entering .nl-card {
    animation: popIn 0.38s cubic-bezier(0.34, 1.45, 0.64, 1) forwards;
  }

  .nl-popup.nl-leaving .nl-card {
    animation: popOut 0.22s ease forwards;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.9) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes popOut {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(0.95) translateY(10px); }
  }

  /* Backdrop */
  .nl-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    cursor: pointer;
  }

  /* Card — wide landscape rectangle */
  .nl-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 760px;
    width: 100%;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.06);
  }

  /* Close */
  .nl-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    z-index: 10;
    padding: 0;
    font-family: inherit;
  }

  .nl-close:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
    border-color: rgba(255,255,255,0.3);
  }

  /* ---- Left panel (dark / branded) ---- */
  .nl-left {
    position: relative;
    background: #0a0a0a;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 320px;
    overflow: hidden;
  }

  /* Geo SVG fills left panel */
  .nl-geo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .nl-geo svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nl-logo {
    position: absolute;
    top: 2rem;
    left: 2.5rem;
    width: 160px;
    z-index: 1;
  }

  .nl-logo svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .nl-eyebrow {
    position: relative;
    z-index: 1;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B8935A;
    font-weight: 600;
    margin: 0 0 0.625rem;
  }

  .nl-heading {
    position: relative;
    z-index: 1;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    white-space: pre-line;
  }

  .nl-bullets {
    position: relative;
    z-index: 1;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nl-bullets li {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.45);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .nl-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #B8935A;
    font-size: 0.75rem;
  }

  /* ---- Right panel (light / form) ---- */
  .nl-right {
    background: var(--bg-surface);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  .nl-tagline {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.55;
    margin: 0;
    padding-top: 0.5rem;
  }

  /* Form */
  .nl-form {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .nl-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nl-input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.8125rem 1rem;
    font-size: 0.9375rem;
    color: var(--fg);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .nl-input::placeholder { color: var(--fg-muted); }

  .nl-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(184, 147, 90, 0.15);
  }

  .nl-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .nl-submit:hover:not(:disabled) {
    background: var(--accent-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(184, 147, 90, 0.4);
  }

  .nl-submit:active:not(:disabled) { transform: translateY(0); }
  .nl-submit:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
  .nl-submit.sent { background: #22c55e; box-shadow: none; }

  .nl-err {
    font-size: 0.8125rem;
    color: #ef4444;
    margin: 0;
    min-height: 1em;
  }

  /* Footer row */
  .nl-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .nl-fine {
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.5;
  }

  .nl-gdpr-link {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nl-gdpr-link:hover { color: var(--fg); }

  .nl-skip-btn {
    background: none;
    border: none;
    color: var(--fg-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    padding: 0.25rem 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nl-skip-btn:hover {
    color: var(--fg);
    text-decoration-color: var(--border);
  }

  /* ---- Mobile: stack vertically ---- */
  @media (max-width: 600px) {
    .nl-card { grid-template-columns: 1fr; }

    .nl-left {
      min-height: 180px;
      padding: 1.75rem;
    }

    .nl-logo { top: 1.5rem; left: 1.75rem; width: 130px; }

    .nl-right { padding: 1.75rem; }
  }
</style>

<script define:vars={{ lang }}>
  const STORAGE_KEY = 'gep_nl_popup'
  const DELAY_MS = 9000
  const SCROLL_THRESHOLD = 0.35

  const popup    = document.getElementById('nl-popup')
  const backdrop = document.getElementById('nl-backdrop')
  const closeBtn = document.getElementById('nl-close')
  const dismissBtn = document.getElementById('nl-dismiss')
  const form     = document.getElementById('nl-pop-form')
  const input    = document.getElementById('nl-pop-email')
  const btn      = document.getElementById('nl-pop-btn')
  const btnText  = btn.querySelector('.nl-btn-text')
  const btnIcon  = btn.querySelector('.nl-btn-icon')
  const btnCheck = btn.querySelector('.nl-btn-check')
  const errEl    = document.getElementById('nl-pop-err')

  function shouldShow() {
    try {
      const val = localStorage.getItem(STORAGE_KEY)
      if (!val) return true
      const { status, ts } = JSON.parse(val)
      if (status === 'subscribed') return false
      if (status === 'dismissed') return Date.now() - ts > 7 * 24 * 60 * 60 * 1000
      return true
    } catch { return true }
  }

  function saveState(status) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status, ts: Date.now() })) } catch {}
  }

  function openPopup() {
    if (!shouldShow()) return
    popup.hidden = false
    popup.classList.add('nl-entering')
    setTimeout(() => popup.classList.remove('nl-entering'), 420)
    setTimeout(() => input.focus(), 380)
  }

  function closePopup(status = 'dismissed') {
    saveState(status)
    popup.classList.add('nl-leaving')
    setTimeout(() => {
      popup.hidden = true
      popup.classList.remove('nl-leaving')
    }, 240)
  }

  let triggered = false
  function trigger() {
    if (triggered || !shouldShow()) return
    triggered = true
    openPopup()
  }

  const timer = setTimeout(trigger, DELAY_MS)

  const onScroll = () => {
    const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight)
    if (scrolled >= SCROLL_THRESHOLD) {
      clearTimeout(timer)
      trigger()
      window.removeEventListener('scroll', onScroll)
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })

  closeBtn.addEventListener('click',   () => closePopup('dismissed'))
  dismissBtn.addEventListener('click', () => closePopup('dismissed'))
  backdrop.addEventListener('click',   () => closePopup('dismissed'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup.hidden) closePopup('dismissed')
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = input.value.trim()
    if (!email) return

    btn.disabled = true
    btnText.textContent = lang === 'en' ? 'Subscribing…' : 'Přihlašuji…'
    btnIcon.hidden = true
    errEl.textContent = ''

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, lang }),
      })

      if (res.ok) {
        btn.classList.add('sent')
        btnText.textContent = lang === 'en' ? 'You\'re in! 🎉' : 'Přihlášeno! 🎉'
        btnCheck.hidden = false
        saveState('subscribed')
        setTimeout(() => closePopup('subscribed'), 2000)
      } else {
        const data = await res.json().catch(() => ({}))
        errEl.textContent = data.error === 'Invalid email'
          ? (lang === 'en' ? 'Please enter a valid email.' : 'Zadejte platný email.')
          : (lang === 'en' ? 'Something went wrong. Try again.' : 'Něco se nepovedlo. Zkuste znovu.')
        btn.disabled = false
        btnText.textContent = lang === 'en' ? 'Subscribe' : 'Přihlásit se'
        btnIcon.hidden = false
      }
    } catch {
      errEl.textContent = lang === 'en' ? 'Something went wrong.' : 'Něco se nepovedlo.'
      btn.disabled = false
      btnText.textContent = lang === 'en' ? 'Subscribe' : 'Přihlásit se'
      btnIcon.hidden = false
    }
  })
</script>

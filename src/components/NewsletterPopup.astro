---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<div
  id="nl-popup"
  class="nl-popup"
  role="dialog"
  aria-modal="true"
  aria-label={isEn ? 'Newsletter signup' : 'Přihlášení k newsletteru'}
  hidden
>
  <div class="nl-backdrop" id="nl-backdrop"></div>

  <div class="nl-card">
    <!-- ───────── Left panel (ink) ───────── -->
    <div class="nl-left">
      <!-- Logo wordmark (text-based, no transparency issues) -->
      <div class="nl-left-top">
        <span class="nl-logo-text" aria-label="Globaal Elevate Production">
          <span style="color:var(--violet-400)">GE</span>P
        </span>
      </div>

      <!-- Text block -->
      <div class="nl-left-bottom">
        <p class="nl-eyebrow">
          {isEn ? 'NEWSLETTER' : 'NEWSLETTER'}
        </p>
        <h2 class="nl-heading">
          {isEn ? 'Stay in the loop.' : 'Zůstaňte v obraze.'}
        </h2>
        <ul class="nl-bullets" aria-label={isEn ? 'What you\'ll receive' : 'Co budete dostávat'}>
          <li>{isEn ? 'Projects & events' : 'Projekty a eventy'}</li>
          <li>{isEn ? 'New music' : 'Nová hudba'}</li>
          <li>{isEn ? 'Behind the scenes' : 'Za kulisami'}</li>
        </ul>
      </div>
    </div>

    <!-- ───────── Right panel (light / form) ───────── -->
    <div class="nl-right">
      <!-- Close button — positioned on white panel -->
      <button class="nl-close" id="nl-close" aria-label={isEn ? 'Close' : 'Zavřít'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Form view (default) -->
      <div class="nl-form-view" id="nl-form-view">
        <p class="nl-subtitle">
          {isEn
            ? 'Get first access to events and new music.'
            : 'Novinky o eventech a nové hudbě dostanete jako první.'}
        </p>

        <form class="nl-form" id="nl-pop-form" novalidate>
          <!-- Honeypot — visually hidden, filled only by bots -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="nl-honeypot"
          />

          <label class="nl-label" for="nl-pop-email">
            {isEn ? 'Email' : 'E-mail'}
          </label>
          <input
            type="email"
            id="nl-pop-email"
            name="email"
            placeholder={isEn ? 'your@email.com' : 'vas@email.cz'}
            required
            autocomplete="email"
            class="nl-input"
            aria-describedby="nl-pop-err"
          />
          <p class="nl-field-err" id="nl-pop-err" aria-live="polite" hidden></p>

          <button type="submit" class="nl-submit" id="nl-pop-btn">
            <span class="nl-btn-text">{isEn ? 'Subscribe →' : 'Přihlásit se →'}</span>
            <span class="nl-btn-spinner" hidden aria-hidden="true">
              <svg class="nl-spinner-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
              {isEn ? 'Sending…' : 'Odesílám…'}
            </span>
          </button>

          <p class="nl-server-err" id="nl-server-err" aria-live="polite" hidden></p>
        </form>

        <p class="nl-fine">
          {isEn ? 'No spam. Unsubscribe anytime.' : 'Bez spamu, odhlásit se můžete kdykoliv.'}
          {' '}
          <a href={isEn ? '/en/gdpr' : '/gdpr'} class="nl-gdpr-link" tabindex="0">
            {isEn ? 'Privacy policy' : 'Zásady ochrany údajů'}
          </a>
        </p>

        <button type="button" id="nl-dismiss" class="nl-skip-btn">
          {isEn ? 'Maybe later' : 'Teď ne'}
        </button>
      </div>

      <!-- Success view — shown after form submit -->
      <div class="nl-success-view" id="nl-success-view" hidden aria-live="polite">
        <div class="nl-success-icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <p class="nl-success-title">
          {isEn ? 'Almost done!' : 'Skoro hotovo!'}
        </p>
        <p class="nl-success-text">
          {isEn
            ? 'We sent you a confirmation email. Click the link inside to complete your signup.'
            : 'Poslali jsme vám e-mail. Klikněte na odkaz v něm a přihlášení potvrďte.'}
        </p>
        <p class="nl-success-hint">
          {isEn
            ? 'Nothing arrived? Check your spam or Promotions folder.'
            : 'Nic nepřišlo? Mrkněte do spamu nebo složky Hromadné.'}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Overlay ── */
  .nl-popup {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .nl-popup[hidden] { display: none !important; }

  .nl-popup.nl-entering .nl-card {
    animation: nlPopIn 0.22s ease-out forwards;
  }

  .nl-popup.nl-leaving .nl-card {
    animation: nlPopOut 0.18s ease-in forwards;
  }

  @keyframes nlPopIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlPopOut {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-popup.nl-entering .nl-card,
    .nl-popup.nl-leaving .nl-card {
      animation: none;
    }
  }

  .nl-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.60);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }

  /* ── Card ── */
  .nl-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 820px;
    width: calc(100% - 2rem);
    min-height: 460px;
    border-radius: 0;
    overflow: hidden;
  }

  /* ── Left panel (ink) ── */
  .nl-left {
    background: var(--ink);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .nl-left-top { margin-bottom: auto; }

  .nl-logo-text {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: -.02em;
    color: var(--white);
  }

  .nl-left-bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 3rem;
  }

  .nl-eyebrow {
    font-family: var(--font);
    font-size: 11px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--muted-dark);
    font-weight: 600;
    margin: 0;
    max-width: none;
  }

  .nl-heading {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(2rem, 3vw, 2.75rem);
    text-transform: uppercase;
    color: var(--white);
    line-height: .93;
    letter-spacing: -.01em;
    margin: 0;
  }

  .nl-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nl-bullets li {
    font-size: 14px;
    color: var(--muted-dark);
    padding-left: 20px;
    position: relative;
    line-height: 1.5;
    max-width: none;
  }

  .nl-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    background: var(--violet-600);
  }

  /* ── Right panel (white) ── */
  .nl-right {
    position: relative;
    background: var(--white);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Close button */
  .nl-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-light);
    background: transparent;
    color: var(--muted-light);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    z-index: 10;
    padding: 0;
    font-family: inherit;
    border-radius: var(--radius-btn);
  }

  .nl-close:hover { color: var(--text-light); border-color: var(--text-light); }
  .nl-close:focus-visible { outline: 3px solid var(--violet-400); outline-offset: 2px; }

  /* Form view */
  .nl-form-view {
    display: flex;
    flex-direction: column;
  }

  .nl-subtitle {
    font-size: 1rem;
    font-weight: 600;
    font-stretch: 100%;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0 0 24px;
    max-width: 32ch;
  }

  .nl-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 14px;
  }

  .nl-honeypot {
    position: absolute;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }

  .nl-label {
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted-light);
    margin-bottom: 8px;
    display: block;
  }

  .nl-input {
    width: 100%;
    height: 52px;
    background: var(--grey-100);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-btn);
    padding: 0 1rem;
    font-size: 1rem;
    color: var(--text-light);
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .nl-input::placeholder { color: var(--muted-light); }

  .nl-input:focus {
    border-color: var(--violet-600);
    outline: 3px solid var(--violet-400);
    outline-offset: 0;
  }

  .nl-input.nl-invalid { border-color: var(--danger); }

  .nl-field-err {
    font-size: 13px;
    color: var(--danger);
    margin: 6px 0 0;
    max-width: none;
  }

  .nl-field-err[hidden] { display: none; }

  .nl-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 52px;
    margin-top: 12px;
    background: var(--violet-600);
    color: #fff;
    border: none;
    border-radius: var(--radius-btn);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .nl-submit:hover:not(:disabled) { background: var(--violet-500); }
  .nl-submit:active:not(:disabled) { background: var(--violet-700); }
  .nl-submit:focus-visible { outline: 3px solid var(--violet-400); outline-offset: 2px; }
  .nl-submit:disabled { opacity: 0.65; cursor: not-allowed; }

  .nl-spinner-svg { animation: nlSpin 0.8s linear infinite; }

  @keyframes nlSpin { to { transform: rotate(360deg); } }

  .nl-server-err {
    font-size: 13px;
    color: var(--danger);
    margin: 8px 0 0;
    max-width: none;
  }

  .nl-server-err[hidden] { display: none; }

  .nl-fine {
    font-size: 12px;
    color: var(--muted-light);
    margin: 0 0 20px;
    line-height: 1.55;
    max-width: none;
  }

  .nl-gdpr-link {
    color: var(--muted-light);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .nl-gdpr-link:hover { color: var(--text-light); }

  .nl-skip-btn {
    background: none;
    border: none;
    color: var(--muted-light);
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    text-align: left;
    transition: color 0.15s ease;
  }

  .nl-skip-btn:hover { color: var(--text-light); }

  /* ── Success view ── */
  .nl-success-view {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nl-success-view[hidden] { display: none; }

  .nl-success-icon {
    width: 52px;
    height: 52px;
    border: 1px solid var(--violet-600);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--violet-600);
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .nl-success-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-light);
    margin: 0;
  }

  .nl-success-text {
    font-size: .9375rem;
    color: var(--muted-light);
    line-height: 1.65;
    margin: 0;
  }

  .nl-success-hint {
    font-size: .8125rem;
    color: var(--muted-light);
    margin: 0;
    opacity: .75;
    max-width: none;
  }

  /* ── Mobile: bottom sheet ── */
  @media (max-width: 767px) {
    .nl-popup {
      align-items: flex-end;
      padding: 0;
    }

    .nl-card {
      grid-template-columns: 1fr;
      width: 100%;
      max-width: 100%;
      min-height: unset;
      max-height: 90dvh;
      border-radius: 0;
      overflow-y: auto;
    }

    @keyframes nlPopIn {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .nl-left {
      padding: 24px;
      min-height: unset;
    }

    .nl-bullets { display: none; }
    .nl-heading { font-size: 2rem; }
    .nl-left-bottom { gap: 10px; padding-top: 1.5rem; }

    .nl-right { padding: 28px 24px 32px; }
    .nl-subtitle { font-size: .9375rem; }
  }
</style>

<script define:vars={{ lang }}>
  const STORAGE_KEY = 'gep_nl_popup'
  const DELAY_MS = 15000          // 15 s
  const SCROLL_THRESHOLD = 0.50   // 50 %
  const DISMISS_TTL_MS = 14 * 24 * 60 * 60 * 1000 // 14 days

  const popup       = document.getElementById('nl-popup')
  const backdrop    = document.getElementById('nl-backdrop')
  const closeBtn    = document.getElementById('nl-close')
  const dismissBtn  = document.getElementById('nl-dismiss')
  const form        = document.getElementById('nl-pop-form')
  const emailInput  = document.getElementById('nl-pop-email')
  const btn         = document.getElementById('nl-pop-btn')
  const btnText     = btn.querySelector('.nl-btn-text')
  const btnSpinner  = btn.querySelector('.nl-btn-spinner')
  const fieldErrEl  = document.getElementById('nl-pop-err')
  const serverErrEl = document.getElementById('nl-server-err')
  const formView    = document.getElementById('nl-form-view')
  const successView = document.getElementById('nl-success-view')
  const honeypot    = form.querySelector('input[name="website"]')

  // Do not show on /newsletter/* or /gdpr
  const path = window.location.pathname
  if (path.startsWith('/newsletter') || path === '/gdpr' || path === '/en/gdpr') {
    popup.hidden = true
  }

  function shouldShow() {
    try {
      const val = localStorage.getItem(STORAGE_KEY)
      if (!val) return true
      const { status, ts } = JSON.parse(val)
      if (status === 'subscribed') return false
      if (status === 'dismissed') return Date.now() - ts > DISMISS_TTL_MS
      return true
    } catch { return true }
  }

  function saveState(status) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status, ts: Date.now() })) } catch {}
  }

  let previousFocus = null

  function openPopup() {
    if (!shouldShow()) return
    previousFocus = document.activeElement
    popup.hidden = false
    popup.classList.add('nl-entering')
    setTimeout(() => popup.classList.remove('nl-entering'), 260)
    setTimeout(() => emailInput?.focus(), 240)
  }

  function closePopup(status = 'dismissed') {
    if (status !== 'subscribed') saveState(status)
    popup.classList.add('nl-leaving')
    setTimeout(() => {
      popup.hidden = true
      popup.classList.remove('nl-leaving')
      previousFocus?.focus()
    }, 200)
  }

  let triggered = false

  function trigger() {
    if (triggered || !shouldShow()) return
    triggered = true
    openPopup()
  }

  const timer = setTimeout(trigger, DELAY_MS)

  const onScroll = () => {
    const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight || 1)
    if (scrolled >= SCROLL_THRESHOLD) {
      clearTimeout(timer)
      trigger()
      window.removeEventListener('scroll', onScroll)
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })

  // Focus trap
  popup.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return
    const focusable = Array.from(
      popup.querySelectorAll('a,button:not([disabled]),input:not([type="hidden"]):not(.nl-honeypot),textarea,select,[tabindex]:not([tabindex="-1"])')
    ).filter(el => !el.hidden && !el.closest('[hidden]') && getComputedStyle(el).display !== 'none')
    if (!focusable.length) return
    const first = focusable[0]
    const last  = focusable[focusable.length - 1]
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus()
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus()
    }
  })

  closeBtn.addEventListener('click',   () => closePopup('dismissed'))
  dismissBtn.addEventListener('click', () => closePopup('dismissed'))
  backdrop.addEventListener('click',   () => closePopup('dismissed'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup.hidden) closePopup('dismissed')
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()

    // Client-side validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    if (!email || !emailRegex.test(email)) {
      emailInput.classList.add('nl-invalid')
      fieldErrEl.textContent = lang === 'en'
        ? 'Please enter a valid email address.'
        : 'Zadejte platný e-mail.'
      fieldErrEl.hidden = false
      emailInput.focus()
      return
    }

    emailInput.classList.remove('nl-invalid')
    fieldErrEl.hidden = true
    serverErrEl.hidden = true
    btn.disabled = true
    btnText.hidden = true
    btnSpinner.hidden = false

    try {
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          website: honeypot?.value ?? '',
          source: 'popup',
          lang,
        }),
      })

      if (res.ok || res.status === 200) {
        // Show success view — modal stays open so user reads instructions
        formView.hidden = true
        successView.hidden = false
        saveState('subscribed')
      } else {
        const data = await res.json().catch(() => ({}))
        let msg = lang === 'en'
          ? 'Something went wrong. Please try again.'
          : 'Něco se pokazilo, zkuste to prosím znovu.'
        if (data.error === 'Invalid email') {
          msg = lang === 'en' ? 'Please enter a valid email address.' : 'Zadejte platný e-mail.'
        } else if (res.status === 429) {
          msg = lang === 'en'
            ? 'Too many attempts. Please try again in a few minutes.'
            : 'Příliš mnoho pokusů. Zkuste to prosím za chvíli.'
        }
        serverErrEl.textContent = msg
        serverErrEl.hidden = false
        btn.disabled = false
        btnText.hidden = false
        btnSpinner.hidden = true
      }
    } catch {
      serverErrEl.textContent = lang === 'en'
        ? 'Something went wrong. Please try again.'
        : 'Něco se pokazilo, zkuste to prosím znovu.'
      serverErrEl.hidden = false
      btn.disabled = false
      btnText.hidden = false
      btnSpinner.hidden = true
    }
  })

  emailInput.addEventListener('input', () => {
    emailInput.classList.remove('nl-invalid')
    fieldErrEl.hidden = true
  })
</script>

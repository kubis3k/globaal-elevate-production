---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<div
  id="nl-popup"
  class="nl-popup"
  role="dialog"
  aria-modal="true"
  aria-label={isEn ? 'Newsletter signup' : 'Přihlášení k newsletteru'}
  hidden
>
  <div class="nl-backdrop" id="nl-backdrop"></div>

  <div class="nl-card">
    <!-- ───────── Left panel (dark / branded) ───────── -->
    <div class="nl-left">
      <!-- Decorative corner brackets (pointer-events none, behind content) -->
      <div class="nl-bracket nl-bracket-tl" aria-hidden="true"></div>
      <div class="nl-bracket nl-bracket-br" aria-hidden="true"></div>

      <!-- Geometric background decoration -->
      <div class="nl-geo" aria-hidden="true">
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="gp1" cx="40%" cy="60%" r="60%">
              <stop offset="0%" stop-color="#B5976A" stop-opacity="0.18"/>
              <stop offset="100%" stop-color="#B5976A" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <ellipse cx="160" cy="240" rx="200" ry="200" fill="url(#gp1)"/>
          <circle cx="200" cy="200" r="175" stroke="#B5976A" stroke-opacity="0.08" stroke-width="1"/>
          <circle cx="200" cy="200" r="120" stroke="#B5976A" stroke-opacity="0.07" stroke-width="1"/>
          <circle cx="200" cy="200" r="70"  stroke="#B5976A" stroke-opacity="0.06" stroke-width="1"/>
          <rect x="100" y="100" width="200" height="200" rx="2" stroke="#B5976A" stroke-opacity="0.1" stroke-width="1" transform="rotate(45 200 200)"/>
          <line x1="0" y1="200" x2="400" y2="200" stroke="#B5976A" stroke-opacity="0.05" stroke-width="1"/>
          <line x1="200" y1="0" x2="200" y2="400" stroke="#B5976A" stroke-opacity="0.05" stroke-width="1"/>
        </svg>
      </div>

      <!-- Logo — top of panel, in normal flow -->
      <div class="nl-left-top">
        <img
          src="/logo.png"
          alt="Globaal Elevate Production"
          class="nl-logo-img"
          width="120"
          height="28"
        />
      </div>

      <!-- Text block — bottom of panel -->
      <div class="nl-left-bottom">
        <p class="nl-eyebrow">
          {isEn ? '• NEWSLETTER' : '• NEWSLETTER'}
        </p>
        <h2 class="nl-heading">
          {isEn ? 'Stay in the loop.' : 'Zůstaňte v obraze.'}
        </h2>
        <ul class="nl-bullets" aria-label={isEn ? 'What you\'ll receive' : 'Co budete dostávat'}>
          <li>{isEn ? 'Projects & events' : 'Projekty a eventy'}</li>
          <li>{isEn ? 'New music' : 'Nová hudba'}</li>
          <li>{isEn ? 'Behind the scenes' : 'Za kulisami'}</li>
        </ul>
      </div>
    </div>

    <!-- ───────── Right panel (light / form) ───────── -->
    <div class="nl-right">
      <!-- Close button — positioned on white panel -->
      <button class="nl-close" id="nl-close" aria-label={isEn ? 'Close' : 'Zavřít'}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Form view (default) -->
      <div class="nl-form-view" id="nl-form-view">
        <p class="nl-subtitle">
          {isEn
            ? 'Get first access to events and new music.'
            : 'Novinky o eventech a nové hudbě dostanete jako první.'}
        </p>

        <form class="nl-form" id="nl-pop-form" novalidate>
          <!-- Honeypot — visually hidden, filled only by bots -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="nl-honeypot"
          />

          <label class="nl-label" for="nl-pop-email">
            {isEn ? 'Email' : 'E-mail'}
          </label>
          <input
            type="email"
            id="nl-pop-email"
            name="email"
            placeholder={isEn ? 'your@email.com' : 'vas@email.cz'}
            required
            autocomplete="email"
            class="nl-input"
            aria-describedby="nl-pop-err"
          />
          <p class="nl-field-err" id="nl-pop-err" aria-live="polite" hidden></p>

          <button type="submit" class="nl-submit" id="nl-pop-btn">
            <span class="nl-btn-text">{isEn ? 'Subscribe →' : 'Přihlásit se →'}</span>
            <span class="nl-btn-spinner" hidden aria-hidden="true">
              <svg class="nl-spinner-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
              {isEn ? 'Sending…' : 'Odesílám…'}
            </span>
          </button>

          <p class="nl-server-err" id="nl-server-err" aria-live="polite" hidden></p>
        </form>

        <p class="nl-fine">
          {isEn ? 'No spam. Unsubscribe anytime.' : 'Bez spamu, odhlásit se můžete kdykoliv.'}
          {' '}
          <a href={isEn ? '/en/gdpr' : '/gdpr'} class="nl-gdpr-link" tabindex="0">
            {isEn ? 'Privacy policy' : 'Zásady ochrany údajů'}
          </a>
        </p>

        <button type="button" id="nl-dismiss" class="nl-skip-btn">
          {isEn ? 'Maybe later' : 'Teď ne'}
        </button>
      </div>

      <!-- Success view — shown after form submit -->
      <div class="nl-success-view" id="nl-success-view" hidden aria-live="polite">
        <div class="nl-success-icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <p class="nl-success-title">
          {isEn ? 'Almost done!' : 'Skoro hotovo!'}
        </p>
        <p class="nl-success-text">
          {isEn
            ? 'We sent you a confirmation email. Click the link inside to complete your signup.'
            : 'Poslali jsme vám e-mail. Klikněte na odkaz v něm a přihlášení potvrďte.'}
        </p>
        <p class="nl-success-hint">
          {isEn
            ? 'Nothing arrived? Check your spam or Promotions folder.'
            : 'Nic nepřišlo? Mrkněte do spamu nebo složky Hromadné.'}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Overlay ── */
  .nl-popup {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .nl-popup[hidden] { display: none !important; }

  .nl-popup.nl-entering .nl-card {
    animation: nlPopIn 0.22s ease-out forwards;
  }

  .nl-popup.nl-leaving .nl-card {
    animation: nlPopOut 0.18s ease-in forwards;
  }

  @keyframes nlPopIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes nlPopOut {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-popup.nl-entering .nl-card,
    .nl-popup.nl-leaving .nl-card {
      animation: none;
    }
  }

  .nl-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.60);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }

  /* ── Card ── */
  .nl-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 820px;
    width: calc(100% - 2rem);
    min-height: 460px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  /* ── Left panel (dark) ── */
  .nl-left {
    position: relative;
    background: #0B0B0B;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  /* Corner brackets */
  .nl-bracket {
    position: absolute;
    width: 24px;
    height: 24px;
    pointer-events: none;
    z-index: 0;
  }

  .nl-bracket-tl {
    top: 20px;
    left: 20px;
    border-top: 1px solid rgba(181, 151, 106, 0.4);
    border-left: 1px solid rgba(181, 151, 106, 0.4);
  }

  .nl-bracket-br {
    bottom: 20px;
    right: 20px;
    border-bottom: 1px solid rgba(181, 151, 106, 0.4);
    border-right: 1px solid rgba(181, 151, 106, 0.4);
  }

  /* Geometric background */
  .nl-geo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .nl-geo svg {
    width: 100%;
    height: 100%;
  }

  /* Logo — top of left panel */
  .nl-left-top {
    position: relative;
    z-index: 1;
  }

  .nl-logo-img {
    height: 28px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  /* Text block — bottom of left panel */
  .nl-left-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nl-eyebrow {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B5976A;
    font-weight: 600;
    margin: 0;
  }

  .nl-heading {
    font-size: 40px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
  }

  .nl-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nl-bullets li {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    padding-left: 24px;
    position: relative;
    line-height: 1.5;
  }

  .nl-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 1px;
    background: #B5976A;
  }

  /* ── Right panel (light) ── */
  .nl-right {
    position: relative;
    background: var(--bg-surface, #ffffff);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Close button */
  .nl-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border, #e5e5e5);
    background: var(--bg-surface, #ffffff);
    color: var(--fg-muted, #888);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    z-index: 10;
    padding: 0;
    font-family: inherit;
  }

  .nl-close:hover {
    background: var(--bg, #f5f5f5);
    color: var(--fg, #111);
    border-color: var(--fg-muted, #888);
  }

  /* Form view */
  .nl-form-view {
    display: flex;
    flex-direction: column;
  }

  .nl-subtitle {
    font-size: 18px;
    font-weight: 600;
    color: #111;
    line-height: 1.4;
    margin: 0 0 24px;
  }

  .nl-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 14px;
  }

  .nl-honeypot {
    position: absolute;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
    tabindex: -1;
  }

  .nl-label {
    font-size: 13px;
    font-weight: 500;
    color: #555;
    margin-bottom: 8px;
    display: block;
  }

  .nl-input {
    width: 100%;
    height: 48px;
    background: #FAFAFA;
    border: 1px solid #E3E3E3;
    border-radius: 10px;
    padding: 0 1rem;
    font-size: 0.9375rem;
    color: #111;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .nl-input::placeholder { color: #bbb; }

  .nl-input:focus {
    border-color: #B5976A;
    box-shadow: 0 0 0 3px rgba(181, 151, 106, 0.2);
  }

  .nl-input.nl-invalid { border-color: #D64545; }

  .nl-field-err {
    font-size: 13px;
    color: #D64545;
    margin: 6px 0 0;
  }

  .nl-field-err[hidden] { display: none; }

  .nl-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    height: 48px;
    margin-top: 12px;
    background: #B5976A;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .nl-submit:hover:not(:disabled) { background: #A3845A; }
  .nl-submit:disabled { opacity: 0.65; cursor: not-allowed; }

  .nl-spinner-svg { animation: nlSpin 0.8s linear infinite; }

  @keyframes nlSpin { to { transform: rotate(360deg); } }

  .nl-server-err {
    font-size: 13px;
    color: #D64545;
    margin: 8px 0 0;
  }

  .nl-server-err[hidden] { display: none; }

  .nl-fine {
    font-size: 13px;
    color: #777;
    margin: 0 0 20px;
    line-height: 1.55;
  }

  .nl-gdpr-link {
    color: #999;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .nl-gdpr-link:hover {
    color: #555;
    text-decoration-color: #999;
  }

  .nl-skip-btn {
    background: none;
    border: none;
    color: #999;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    text-align: left;
    transition: color 0.15s ease;
  }

  .nl-skip-btn:hover { color: #333; }

  /* ── Success view ── */
  .nl-success-view {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nl-success-view[hidden] { display: none; }

  .nl-success-icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: #FDF8F2;
    border: 1px solid rgba(181, 151, 106, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B5976A;
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .nl-success-title {
    font-size: 22px;
    font-weight: 700;
    color: #111;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .nl-success-text {
    font-size: 15px;
    color: #444;
    line-height: 1.65;
    margin: 0;
  }

  .nl-success-hint {
    font-size: 13px;
    color: #999;
    margin: 0;
    line-height: 1.55;
  }

  /* ── Mobile: single column bottom sheet ── */
  @media (max-width: 767px) {
    .nl-popup {
      align-items: flex-end;
      padding: 0;
    }

    .nl-card {
      grid-template-columns: 1fr;
      width: 100%;
      max-width: 100%;
      min-height: unset;
      max-height: 90vh;
      border-radius: 20px 20px 0 0;
      overflow-y: auto;
      box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.35);
    }

    @keyframes nlPopIn {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .nl-left {
      padding: 24px;
      min-height: unset;
    }

    .nl-left-top {
      margin-bottom: 16px;
    }

    .nl-bullets { display: none; }

    .nl-heading {
      font-size: 30px;
    }

    .nl-left-bottom {
      gap: 10px;
    }

    .nl-bracket { display: none; }

    .nl-right {
      padding: 28px 24px 32px;
    }

    .nl-subtitle {
      font-size: 16px;
      margin-bottom: 20px;
    }

    .nl-input,
    .nl-submit {
      height: 52px;
    }
  }
</style>

<script define:vars={{ lang }}>
  const STORAGE_KEY = 'gep_nl_popup'
  const DELAY_MS = 15000          // 15 s
  const SCROLL_THRESHOLD = 0.50   // 50 %
  const DISMISS_TTL_MS = 14 * 24 * 60 * 60 * 1000 // 14 days

  const popup       = document.getElementById('nl-popup')
  const backdrop    = document.getElementById('nl-backdrop')
  const closeBtn    = document.getElementById('nl-close')
  const dismissBtn  = document.getElementById('nl-dismiss')
  const form        = document.getElementById('nl-pop-form')
  const emailInput  = document.getElementById('nl-pop-email')
  const btn         = document.getElementById('nl-pop-btn')
  const btnText     = btn.querySelector('.nl-btn-text')
  const btnSpinner  = btn.querySelector('.nl-btn-spinner')
  const fieldErrEl  = document.getElementById('nl-pop-err')
  const serverErrEl = document.getElementById('nl-server-err')
  const formView    = document.getElementById('nl-form-view')
  const successView = document.getElementById('nl-success-view')
  const honeypot    = form.querySelector('input[name="website"]')

  // Do not show on /newsletter/* or /gdpr
  const path = window.location.pathname
  if (path.startsWith('/newsletter') || path === '/gdpr' || path === '/en/gdpr') {
    popup.hidden = true
  }

  function shouldShow() {
    try {
      const val = localStorage.getItem(STORAGE_KEY)
      if (!val) return true
      const { status, ts } = JSON.parse(val)
      if (status === 'subscribed') return false
      if (status === 'dismissed') return Date.now() - ts > DISMISS_TTL_MS
      return true
    } catch { return true }
  }

  function saveState(status) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status, ts: Date.now() })) } catch {}
  }

  let previousFocus = null

  function openPopup() {
    if (!shouldShow()) return
    previousFocus = document.activeElement
    popup.hidden = false
    popup.classList.add('nl-entering')
    setTimeout(() => popup.classList.remove('nl-entering'), 260)
    setTimeout(() => emailInput?.focus(), 240)
  }

  function closePopup(status = 'dismissed') {
    if (status !== 'subscribed') saveState(status)
    popup.classList.add('nl-leaving')
    setTimeout(() => {
      popup.hidden = true
      popup.classList.remove('nl-leaving')
      previousFocus?.focus()
    }, 200)
  }

  let triggered = false

  function trigger() {
    if (triggered || !shouldShow()) return
    triggered = true
    openPopup()
  }

  const timer = setTimeout(trigger, DELAY_MS)

  const onScroll = () => {
    const scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight || 1)
    if (scrolled >= SCROLL_THRESHOLD) {
      clearTimeout(timer)
      trigger()
      window.removeEventListener('scroll', onScroll)
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })

  // Focus trap
  popup.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return
    const focusable = Array.from(
      popup.querySelectorAll('a,button:not([disabled]),input:not([type="hidden"]):not(.nl-honeypot),textarea,select,[tabindex]:not([tabindex="-1"])')
    ).filter(el => !el.hidden && !el.closest('[hidden]') && getComputedStyle(el).display !== 'none')
    if (!focusable.length) return
    const first = focusable[0]
    const last  = focusable[focusable.length - 1]
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus()
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus()
    }
  })

  closeBtn.addEventListener('click',   () => closePopup('dismissed'))
  dismissBtn.addEventListener('click', () => closePopup('dismissed'))
  backdrop.addEventListener('click',   () => closePopup('dismissed'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup.hidden) closePopup('dismissed')
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()

    // Client-side validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    if (!email || !emailRegex.test(email)) {
      emailInput.classList.add('nl-invalid')
      fieldErrEl.textContent = lang === 'en'
        ? 'Please enter a valid email address.'
        : 'Zadejte platný e-mail.'
      fieldErrEl.hidden = false
      emailInput.focus()
      return
    }

    emailInput.classList.remove('nl-invalid')
    fieldErrEl.hidden = true
    serverErrEl.hidden = true
    btn.disabled = true
    btnText.hidden = true
    btnSpinner.hidden = false

    try {
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          website: honeypot?.value ?? '',
          source: 'popup',
          lang,
        }),
      })

      if (res.ok || res.status === 200) {
        // Show success view — modal stays open so user reads instructions
        formView.hidden = true
        successView.hidden = false
        saveState('subscribed')
      } else {
        const data = await res.json().catch(() => ({}))
        let msg = lang === 'en'
          ? 'Something went wrong. Please try again.'
          : 'Něco se pokazilo, zkuste to prosím znovu.'
        if (data.error === 'Invalid email') {
          msg = lang === 'en' ? 'Please enter a valid email address.' : 'Zadejte platný e-mail.'
        } else if (res.status === 429) {
          msg = lang === 'en'
            ? 'Too many attempts. Please try again in a few minutes.'
            : 'Příliš mnoho pokusů. Zkuste to prosím za chvíli.'
        }
        serverErrEl.textContent = msg
        serverErrEl.hidden = false
        btn.disabled = false
        btnText.hidden = false
        btnSpinner.hidden = true
      }
    } catch {
      serverErrEl.textContent = lang === 'en'
        ? 'Something went wrong. Please try again.'
        : 'Něco se pokazilo, zkuste to prosím znovu.'
      serverErrEl.hidden = false
      btn.disabled = false
      btnText.hidden = false
      btnSpinner.hidden = true
    }
  })

  emailInput.addEventListener('input', () => {
    emailInput.classList.remove('nl-invalid')
    fieldErrEl.hidden = true
  })
</script>

---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const isEn = lang === 'en'
---

<footer class="site-footer">
  <div class="footer-top container">
    <div class="footer-col footer-brand">
      <a href={isEn ? '/en/' : '/'} class="footer-logo-link" aria-label={isEn ? 'Home' : 'Domů'}>
        <span class="footer-wordmark" aria-hidden="true">
          <span style="color:var(--violet-400)">GE</span>P
        </span>
        <span class="footer-name">Globaal Elevate</span>
      </a>
      <p class="footer-tagline">
        {isEn
          ? 'Creative group combining music, events and technology.'
          : 'Tvoříme značky, které mají skutečný základ.'}
      </p>
      <div class="footer-social">
        <a href="https://www.instagram.com/3lwave.cz/" class="social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <!-- LinkedIn: add when profile is ready -->
      </div>
    </div>

    <div class="footer-col">
      <p class="footer-heading">{isEn ? 'Navigation' : 'Navigace'}</p>
      <ul class="footer-links" role="list">
        <li><a href={isEn ? '/en/' : '/'} class="footer-link">{isEn ? 'Home' : 'Domů'}</a></li>
        <li><a href={isEn ? '/en/o-nas' : '/o-nas'} class="footer-link">{isEn ? 'About us' : 'O nás'}</a></li>
        <li><a href={isEn ? '/en/portfolio' : '/portfolio'} class="footer-link">{isEn ? 'Portfolio' : 'Portfolio'}</a></li>
        <li><a href={isEn ? '/en/novinky' : '/novinky'} class="footer-link">{isEn ? 'News' : 'Novinky'}</a></li>
        <li><a href={isEn ? '/en/kontakt' : '/kontakt'} class="footer-link">{isEn ? 'Contact' : 'Kontakt'}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-heading">{isEn ? 'Our brands' : 'Naše značky'}</p>
      <ul class="footer-links" role="list">
        <li><a href="https://3lwave.cz" class="footer-link footer-link-ext" target="_blank" rel="noopener">3lwave.cz</a></li>
        <li><a href="#" class="footer-link footer-link-ext" target="_blank" rel="noopener">Globaal Records</a></li>
        <li><a href="#" class="footer-link" target="_blank" rel="noopener">Globaal Production</a></li>
        <li><a href="https://visiontechnology.cz" class="footer-link footer-link-ext" target="_blank" rel="noopener">Vision Technology</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-heading">{isEn ? 'Contact' : 'Kontakt'}</p>
      <ul class="footer-links" role="list">
        <li><a href="mailto:info@globaalelevate.com" class="footer-link">info@globaalelevate.com</a></li>
        <li><a href="tel:+420725628044" class="footer-link">+420 725 628 044</a></li>
        <li><span class="footer-text">Praha · Chomutov</span></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <p class="footer-legal">
      © 2026 Globaal Elevate Production s.r.o. IČO 24972070 C 446827, Městský soud v Praze
    </p>
    <a href={isEn ? '/en/gdpr' : '/gdpr'} class="footer-link footer-gdpr">GDPR</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    border-top: 1px solid var(--line-dark);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .footer-col {
    border-left: 1px solid var(--line-dark);
    padding-left: 2rem;
  }
  .footer-col:first-child { border-left: none; padding-left: 0; }

  /* Logo */
  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: .5rem;
    text-decoration: none;
    color: var(--white);
    margin-bottom: 1rem;
  }

  .footer-wordmark {
    font-family: var(--font);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: -.02em;
    color: var(--white);
    opacity: .85;
  }

  .footer-name {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted-dark);
  }

  .footer-tagline {
    font-size: .875rem;
    color: var(--muted-dark);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 26ch;
  }

  .footer-social {
    display: flex;
    gap: .75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-dark);
    color: var(--muted-dark);
    transition: color 0.15s, border-color 0.15s;
  }

  .social-link:hover {
    color: var(--white);
    border-color: var(--line-dark);
  }

  .social-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 2px; }

  /* Cols */
  .footer-heading {
    font-family: var(--font);
    font-weight: 600;
    font-stretch: 100%;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted-dark);
    margin-bottom: 1.25rem;
    max-width: none;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .footer-link {
    font-size: .875rem;
    color: var(--muted-dark);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--white); }
  .footer-link:focus-visible { outline: 2px solid var(--violet-400); outline-offset: 2px; }

  .footer-link-ext::after { content: ' ↗'; font-size: .75rem; }

  .footer-text {
    font-size: .875rem;
    color: var(--muted-dark);
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .footer-legal {
    font-size: .75rem;
    color: var(--muted-dark);
    opacity: .7;
    max-width: none;
  }

  .footer-gdpr {
    font-family: var(--font);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted-dark);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-col:nth-child(3),
    .footer-col:nth-child(4) { border-left: none; padding-left: 0; }
  }

  @media (max-width: 600px) {
    .footer-top { grid-template-columns: 1fr; gap: 2rem; }
    .footer-col { border-left: none !important; padding-left: 0 !important; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

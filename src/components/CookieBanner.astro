---
interface Props {
  lang?: string
}
const { lang = 'cs' } = Astro.props
const t = lang === 'en'
  ? {
      text: 'We use anonymous, cookieless analytics only. No tracking cookies.',
      accept: 'Got it',
      decline: 'Decline',
      link: '/en/gdpr',
      linkLabel: 'Privacy Policy',
    }
  : {
      text: 'Používáme pouze anonymní analytiku bez cookies. Žádné sledovací cookies.',
      accept: 'Rozumím',
      decline: 'Odmítnout',
      link: '/gdpr',
      linkLabel: 'Zásady ochrany',
    }
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-text">
    {t.text}
    <a href={t.link} class="cookie-link">{t.linkLabel}</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-decline" class="cookie-btn cookie-btn-outline">{t.decline}</button>
    <button id="cookie-accept" class="cookie-btn cookie-btn-filled">{t.accept}</button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'gep_cookie_consent'
  const banner = document.getElementById('cookie-banner')
  const stored = localStorage.getItem(STORAGE_KEY)

  if (!stored) {
    setTimeout(() => {
      if (banner) banner.hidden = false
    }, 1500)
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted')
    if (banner) banner.hidden = true
  })

  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'declined')
    if (banner) banner.hidden = true
  })
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9000;
    width: calc(100% - 2rem);
    max-width: 640px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    animation: slideUp 0.35s ease forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(16px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .cookie-text {
    flex: 1;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    line-height: 1.55;
    margin: 0;
  }

  .cookie-link {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .cookie-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.4rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .cookie-btn:hover { opacity: 0.8; }

  .cookie-btn-filled {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .cookie-btn-outline {
    background: transparent;
    color: var(--fg-muted);
  }

  @media (max-width: 540px) {
    .cookie-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
      bottom: 1rem;
    }
  }
</style>

# ─── Resend (email) ───────────────────────────────────────────────────────────
# API klíč z Resend dashboardu (resend.com → API Keys)
RESEND_API_KEY=

# ID audience pro newsletter (Resend → Audiences)
RESEND_AUDIENCE_ID=

# Odesílací adresa newsletteru — doména musí být ověřená v Resendu
# Příklad: "Globaal Elevate <newsletter@globaalelevate.com>"
NEWSLETTER_FROM=

# Interní e-mail pro notifikace z kontaktního formuláře
RESEND_TO_BUSINESS=info@globaalelevate.com

# E-mail pro booking poptávky
RESEND_TO_BOOKING=booking@globaalelevate.com

# ─── Newsletter double opt-in ─────────────────────────────────────────────────
# Tajný klíč pro podepisování potvrzovacích tokenů (min. 32 náhodných bajtů).
# Vygenerovat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NEWSLETTER_TOKEN_SECRET=

# Veřejná URL webu — používá se v potvrzovacím e-mailu
PUBLIC_SITE_URL=https://globaalelevate.com

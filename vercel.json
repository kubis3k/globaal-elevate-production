{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.globaalelevate.com" }],
      "destination": "https://globaalelevate.com/:path*",
      "permanent": true
    },
    { "source": "/akce/:path*", "destination": "/", "permanent": true },
    { "source": "/grafika", "destination": "/portfolio", "permanent": true },
    { "source": "/grafika/:path*", "destination": "/portfolio", "permanent": true },
    { "source": "/label", "destination": "/portfolio", "permanent": true },
    { "source": "/label/:path*", "destination": "/portfolio", "permanent": true },
    { "source": "/kariera", "destination": "/kontakt", "permanent": true },
    { "source": "/kariera/:path*", "destination": "/kontakt", "permanent": true },
    { "source": "/poptavka", "destination": "/kontakt", "permanent": true },
    { "source": "/podminky-uziti", "destination": "/gdpr", "permanent": true },
    { "source": "/zasady-ochrany-osobnich-udaju", "destination": "/gdpr", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
